<?xml version="1.0" encoding="utf-8"?>
<com.rescuefarm.ui.common.NavigationAwareScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/rescue_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="@dimen/space_md">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:paddingEnd="@dimen/space_sm">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/checkout_title" android:textAppearance="@style/TextAppearance.RescueFarm.Display" />
            <TextView android:id="@+id/checkoutOwnerText" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <Spinner android:id="@+id/checkoutSavedAddressSpinner" android:layout_width="match_parent" android:layout_height="@dimen/touch_target_min" android:visibility="gone" android:contentDescription="@string/checkout_saved_address_label" />
            <EditText android:id="@+id/checkoutName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/receiver_name_hint" />
            <EditText android:id="@+id/checkoutPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/receiver_phone_hint" android:inputType="phone" />
            <TextView android:id="@+id/checkoutSellerAddress" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingVertical="12dp"
            android:text="@string/checkout_store_loading" android:textColor="@color/rescue_primary" />
        <TextView android:id="@+id/checkoutReceiverAddressTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/checkout_receiver_address_title"
            android:textStyle="bold" />
        <com.rescuefarm.ui.common.VietnamAddressView android:id="@+id/checkoutAddress" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/checkoutLocationHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/checkout_location_hint" />
        <com.google.android.material.button.MaterialButton android:id="@+id/checkoutUseLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/checkout_location_action" />
            <TextView android:id="@+id/checkoutGpsStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingVertical="8dp"
            android:text="@string/delivery_gps_required" android:textColor="@color/rescue_on_surface_variant" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:paddingStart="@dimen/space_sm">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fulfillment_label" />
            <Spinner android:id="@+id/checkoutFulfillment" android:layout_width="match_parent" android:layout_height="@dimen/touch_target_min" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/payment_method_label" />
            <Spinner android:id="@+id/checkoutPayment" android:layout_width="match_parent" android:layout_height="@dimen/touch_target_min" />
            <EditText android:id="@+id/checkoutNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/order_note_hint" android:minLines="2" />
            <TextView android:id="@+id/checkoutSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/space_md" android:background="@color/rescue_primary_container" />
            <TextView android:id="@+id/checkoutShippingEstimate" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/checkoutMessage" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <com.google.android.material.button.MaterialButton android:id="@+id/submitCheckoutButton"
                android:layout_width="match_parent" android:layout_height="@dimen/touch_target_min"
                android:text="@string/place_order_action" />
        </LinearLayout>
    </LinearLayout>
</com.rescuefarm.ui.common.NavigationAwareScrollView>
