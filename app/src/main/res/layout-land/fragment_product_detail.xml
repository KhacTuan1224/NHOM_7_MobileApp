<?xml version="1.0" encoding="utf-8"?>
<com.rescuefarm.ui.common.NavigationAwareNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/rescue_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="@dimen/space_md">
        <ImageView android:id="@+id/productDetailImage" android:layout_width="0dp" android:layout_height="260dp" android:layout_weight="0.9" android:contentDescription="@string/product_image_description" android:scaleType="centerCrop" android:background="@color/rescue_outline" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.1" android:orientation="vertical" android:paddingStart="@dimen/space_md">
            <TextView android:id="@+id/productDetailName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.RescueFarm.Display" />
            <TextView android:id="@+id/productDetailPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:textSize="20sp" android:textColor="@color/rescue_primary" android:textStyle="bold" />
            <TextView android:id="@+id/productDiscount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="@dimen/space_sm">
                <EditText android:id="@+id/pricingQuantityInput" android:layout_width="0dp" android:layout_height="@dimen/touch_target_min" android:layout_weight="1" android:hint="@string/pricing_quantity_hint" android:inputType="numberDecimal" android:text="1" />
                <com.google.android.material.button.MaterialButton android:id="@+id/recalculatePriceButton" android:layout_width="wrap_content" android:layout_height="@dimen/touch_target_min" android:text="@string/recalculate_price_action" />
            </LinearLayout>
            <TextView android:id="@+id/priceBreakdownText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:padding="@dimen/space_sm" android:background="@color/rescue_primary_container" android:textColor="@color/rescue_on_primary_container" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="@dimen/space_sm">
                <com.google.android.material.button.MaterialButton android:id="@+id/addToCartButton" android:layout_width="0dp" android:layout_height="@dimen/touch_target_min" android:layout_weight="1" android:text="@string/add_to_cart_action" />
                <com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.OutlinedButton" android:id="@+id/openCartButton" android:layout_width="wrap_content" android:layout_height="@dimen/touch_target_min" android:text="@string/open_cart_action" />
            </LinearLayout>
            <TextView android:id="@+id/productDetailOrigin" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" />
            <TextView android:id="@+id/productStock" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:textStyle="bold" />
                <TextView android:id="@+id/productBatchLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:text="Chọn lô nông sản" />
                <Spinner android:id="@+id/productBatchSpinner" android:layout_width="match_parent" android:layout_height="@dimen/touch_target_min" android:layout_marginTop="@dimen/space_xs" />
                <TextView android:id="@+id/productBatchHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" />
            <TextView android:id="@+id/productDetailDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:textColor="@color/rescue_on_surface_variant" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/favoriteProductButton" android:layout_width="0dp" android:layout_height="@dimen/touch_target_min" android:layout_weight="1" android:text="@string/toggle_favorite_action" />
                <com.google.android.material.button.MaterialButton android:id="@+id/openReviewsButton" android:layout_width="0dp" android:layout_height="@dimen/touch_target_min" android:layout_weight="1" android:text="@string/reviews_title" />
                <com.google.android.material.button.MaterialButton android:id="@+id/reportProductButton" android:layout_width="0dp" android:layout_height="@dimen/touch_target_min" android:layout_weight="1" android:text="@string/report_action" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.rescuefarm.ui.common.NavigationAwareNestedScrollView>
