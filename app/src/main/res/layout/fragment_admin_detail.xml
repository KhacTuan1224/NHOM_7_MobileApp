<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/rescue_background" android:fillViewport="true"
    android:clipToPadding="false" android:paddingBottom="@dimen/admin_scroll_bottom_clearance">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/space_lg">
        <com.google.android.material.button.MaterialButton android:id="@+id/adminDetailBackButton"
            style="@style/Widget.RescueFarm.AdminOutlinedButton"
            android:layout_width="match_parent" android:layout_height="@dimen/touch_target_min"
            android:text="Quay lại danh sách" android:gravity="start|center_vertical" />
        <TextView android:id="@+id/adminDetailTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md"
            android:textAppearance="@style/TextAppearance.RescueFarm.HeadlineMedium" />
        <TextView android:id="@+id/adminDetailSubtitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs"
            android:textColor="@color/rescue_on_surface_variant" />
        <ProgressBar android:id="@+id/adminDetailProgress" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_md" />
        <TextView android:id="@+id/adminDetailMessage" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm"
            android:textColor="@color/rescue_on_surface_variant" />
        <com.google.android.material.button.MaterialButton android:id="@+id/adminDetailRetryButton"
            style="@style/Widget.RescueFarm.AdminOutlinedButton"
            android:layout_width="match_parent" android:layout_height="@dimen/touch_target_min"
            android:layout_marginTop="@dimen/space_sm" android:text="Tải lại chi tiết"
            android:visibility="gone" />
        <LinearLayout android:id="@+id/adminDetailContent" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="@dimen/space_md" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
