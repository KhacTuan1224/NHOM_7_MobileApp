<?xml version="1.0" encoding="utf-8"?>
<com.rescuefarm.ui.common.NavigationAwareScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rescue_background"
    android:fillViewport="true">

    <com.rescuefarm.ui.common.ResponsiveContentLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp" android:layout_gravity="center_horizontal" app:maxContentWidth="@dimen/reading_max_width">

        <include layout="@layout/view_detail_header" />

        <TextView android:textAppearance="@style/TextAppearance.RescueFarm.Detail.Body"
            android:id="@+id/orderDetailCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:textColor="@color/rescue_on_surface"
            android:textStyle="bold" />

        <TextView android:textAppearance="@style/TextAppearance.RescueFarm.Detail.Body"
            android:id="@+id/orderDetailStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_fixed_badge"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textColor="@color/rescue_primary"
            android:textStyle="bold" />

        <LinearLayout android:id="@+id/orderPaymentVerificationPanel"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:orientation="vertical"
            android:background="@drawable/bg_quantity_stepper" android:padding="16dp"
            android:visibility="gone">
            <TextView android:textAppearance="@style/TextAppearance.RescueFarm.Detail.Section" android:id="@+id/orderPaymentVerificationTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" />
            <TextView android:textAppearance="@style/TextAppearance.RescueFarm.Detail.Body" android:id="@+id/orderPaymentVerificationMessage"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
            <ProgressBar android:id="@+id/orderPaymentVerificationProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="4dp"
                android:layout_marginTop="12dp" android:indeterminate="true"
                android:visibility="gone" />
        </LinearLayout>

        <TextView android:textAppearance="@style/TextAppearance.RescueFarm.Detail.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="Thông tin đơn hàng" />

        <LinearLayout
            android:id="@+id/orderDetailInfoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="vertical" />

        <TextView android:textAppearance="@style/TextAppearance.RescueFarm.Detail.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="Tiến trình đơn hàng" />

        <LinearLayout
            android:id="@+id/orderStatusTimeline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="vertical" />

        <TextView android:textAppearance="@style/TextAppearance.RescueFarm.Detail.Body"
            android:id="@+id/paymentInstructionsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@color/rescue_primary_container"
            android:padding="16dp"
            android:textColor="@color/rescue_on_primary_container" />

        <TextView android:textAppearance="@style/TextAppearance.RescueFarm.Detail.Section"
            android:id="@+id/orderItemsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="Sản phẩm trong đơn" />

        <LinearLayout
            android:id="@+id/orderItemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_xs" />

        <TextView android:textAppearance="@style/TextAppearance.RescueFarm.Detail.Body"
            android:id="@+id/orderBankInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@color/rescue_primary_container"
            android:padding="16dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/orderBankQr"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="QR chuyển khoản"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView android:textAppearance="@style/TextAppearance.RescueFarm.Detail.Section"
            android:id="@+id/shipmentManagementTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/shipment_management_title"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/shipmentCarrierInput"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_min"
            android:contentDescription="@string/shipment_carrier_hint"
            android:visibility="gone" />

        <EditText
            android:id="@+id/shipmentTrackingInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/shipment_tracking_hint"
            android:maxLength="120"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveShipmentDetailsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/save_shipment_details_action"
            android:visibility="gone" />

        <TextView android:textAppearance="@style/TextAppearance.RescueFarm.Detail.Section"
            android:id="@+id/orderStatusActionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="Cập nhật trạng thái đơn"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/orderStatusTarget"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_min"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/transitionOrderButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min"
            android:text="@string/update_order_status_action"
            android:visibility="gone" />

        <TextView android:textAppearance="@style/TextAppearance.RescueFarm.Detail.Section"
            android:id="@+id/bankTransferActionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="Xác nhận thanh toán"
            android:visibility="gone" />

        <EditText
            android:id="@+id/bankReferenceInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/bank_reference_hint"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmBankTransferButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min"
            android:text="@string/confirm_bank_transfer_action"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmReceiptButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target_min" android:layout_marginTop="16dp"
            android:text="Đã nhận hàng" android:visibility="gone" />

        <TextView android:textAppearance="@style/TextAppearance.RescueFarm.Detail.Body"
            android:id="@+id/orderLifecycleMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/rescue_on_surface_variant" />
    </com.rescuefarm.ui.common.ResponsiveContentLayout>
</com.rescuefarm.ui.common.NavigationAwareScrollView>
