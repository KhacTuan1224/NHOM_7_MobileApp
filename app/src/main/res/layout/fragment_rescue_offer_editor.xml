<?xml version="1.0" encoding="utf-8"?>
<com.rescuefarm.ui.common.NavigationAwareNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@color/rescue_background">
    <com.rescuefarm.ui.common.ResponsiveContentLayout android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"
        android:layout_gravity="center_horizontal" app:maxContentWidth="@dimen/content_max_width">
        <com.google.android.material.button.MaterialButton android:id="@+id/rescueEditorBack"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Quay lại" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/rescue_create" android:fontFamily="@font/ibm_plex_sans"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="12dp" android:paddingBottom="12dp"
            android:text="Mỗi suất giữ đúng lượng từ các lô bạn chọn. Hạn nhận phải trước hạn dùng của mọi lô. Chọn lô chưa gắn chiến dịch; không tạo lô ảo cho combo. Giá và nội dung gói không đổi sau khi tạo."
            android:textColor="@color/rescue_on_surface_variant" />
        <ProgressBar android:id="@+id/rescueEditorProgress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:visibility="gone" />
        <TextView android:id="@+id/rescueEditorMessage" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/rescue_critical" android:accessibilityLiveRegion="polite" />
        <LinearLayout android:id="@+id/rescueEditorForm" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </com.rescuefarm.ui.common.ResponsiveContentLayout>
</com.rescuefarm.ui.common.NavigationAwareNestedScrollView>
