<?xml version="1.0" encoding="utf-8"?>
<com.rescuefarm.ui.common.NavigationAwareNestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rescue_background"
    android:fillViewport="true">
    <com.rescuefarm.ui.common.ResponsiveContentLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        app:maxContentWidth="@dimen/reading_max_width">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:fontFamily="@font/ibm_plex_sans"
            android:text="@string/guest_profile_title"
            android:textColor="@color/rescue_on_surface"
            android:textSize="32sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/guestProfileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ibm_plex_sans"
                        android:text="@string/guest_profile_name"
                        android:textColor="@color/rescue_on_surface"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/guestProfileSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/barlow"
                        android:text="@string/guest_profile_subtitle"
                        android:textColor="@color/rescue_on_surface_variant"
                        android:textSize="14sp" />
                </LinearLayout>
                <ImageView
                    android:id="@+id/guestAvatar"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_account_profile_avatar"
                    android:clipToOutline="true"
                    android:contentDescription="@string/guest_profile_name"
                    android:padding="12dp"
                    android:src="@drawable/ic_nav_profile"
                    app:tint="@color/rescue_primary" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/guestLoginRegisterButton"
                style="@style/Widget.RescueFarm.AccountProfilePrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/guest_login_register_action"
                app:icon="@drawable/ic_role_customer" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/ibm_plex_sans"
            android:text="@string/guest_profile_utilities_title"
            android:textColor="@color/rescue_on_surface"
            android:textSize="18sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/guestMenuTrackOrder"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingVertical="12dp"
            android:minHeight="72dp"
            android:layout_marginBottom="4dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home_search"
                app:tint="@color/rescue_primary"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ibm_plex_sans"
                    android:text="@string/guest_menu_track_order_title"
                    android:textColor="@color/rescue_on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/barlow"
                    android:text="@string/guest_menu_track_order_sub"
                    android:textColor="@color/rescue_on_surface_variant"
                    android:textSize="14sp" />
            </LinearLayout>
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/rescue_on_surface_variant"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/guestMenuRecentOrders"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingVertical="12dp"
            android:minHeight="72dp"
            android:layout_marginBottom="4dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_orders"
                app:tint="@color/rescue_primary"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ibm_plex_sans"
                    android:text="@string/guest_menu_recent_orders_title"
                    android:textColor="@color/rescue_on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/barlow"
                    android:text="@string/guest_menu_recent_orders_sub"
                    android:textColor="@color/rescue_on_surface_variant"
                    android:textSize="14sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/guestRecentOrdersCountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_fixed_badge"
                android:fontFamily="@font/ibm_plex_sans"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/rescue_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/rescue_on_surface_variant"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/guestMenuLocationSettings"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingVertical="12dp"
            android:minHeight="72dp"
            android:layout_marginBottom="4dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home_location"
                app:tint="@color/rescue_primary"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ibm_plex_sans"
                    android:text="@string/guest_menu_location_title"
                    android:textColor="@color/rescue_on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/barlow"
                    android:text="@string/guest_menu_location_sub"
                    android:textColor="@color/rescue_on_surface_variant"
                    android:textSize="14sp" />
            </LinearLayout>
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/rescue_on_surface_variant"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/guestMenuHelpCenter"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingVertical="12dp"
            android:minHeight="72dp"
            android:layout_marginBottom="4dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_splash_sprout"
                app:tint="@color/rescue_primary"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ibm_plex_sans"
                    android:text="@string/guest_menu_help_title"
                    android:textColor="@color/rescue_on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/barlow"
                    android:text="@string/guest_menu_help_sub"
                    android:textColor="@color/rescue_on_surface_variant"
                    android:textSize="14sp" />
            </LinearLayout>
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/rescue_on_surface_variant"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </com.rescuefarm.ui.common.ResponsiveContentLayout>
</com.rescuefarm.ui.common.NavigationAwareNestedScrollView>
