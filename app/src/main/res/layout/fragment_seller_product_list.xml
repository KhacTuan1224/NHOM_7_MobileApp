<?xml version="1.0" encoding="utf-8"?>
<com.rescuefarm.ui.common.NavigationAwareNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/rescue_background" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.rescuefarm.ui.common.ResponsiveContentLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/space_lg" android:layout_gravity="center_horizontal" app:maxContentWidth="@dimen/content_max_width">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:id="@+id/sellerProductListTitle" android:text="@string/seller_products_title"
            android:textAppearance="@style/TextAppearance.RescueFarm.Display" />
        <TextView android:id="@+id/sellerProductListNotice" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm" android:text="@string/seller_approval_catalog_notice"
            android:textColor="@color/rescue_on_surface_variant" />
        <com.google.android.material.button.MaterialButton android:id="@+id/addProductButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min"
            android:layout_marginTop="@dimen/space_lg" android:text="@string/add_product_action" />
        <LinearLayout android:id="@+id/sellerProductContainer" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" android:orientation="vertical" />
    </com.rescuefarm.ui.common.ResponsiveContentLayout>
</com.rescuefarm.ui.common.NavigationAwareNestedScrollView>
