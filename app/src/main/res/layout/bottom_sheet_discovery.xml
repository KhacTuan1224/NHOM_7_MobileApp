<?xml version="1.0" encoding="utf-8"?>
<com.rescuefarm.ui.common.NavigationAwareNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rescue_background">

    <com.rescuefarm.ui.common.ResponsiveContentLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md" android:layout_gravity="center_horizontal" app:maxContentWidth="@dimen/content_max_width">

        <!-- Header with close button -->
        <com.rescuefarm.ui.common.ResponsiveActionLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <TextView android:fontFamily="@font/ibm_plex_sans"
                android:id="@+id/discoverySheetTitle"
                style="@style/TextAppearance.Material3.HeadlineMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/discovery_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/closeButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min"
                android:contentDescription="Đóng"
                app:icon="@drawable/ic_close"
                app:iconGravity="textStart" />
        </com.rescuefarm.ui.common.ResponsiveActionLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/discoveryKeywordLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/discovery_keyword">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/province_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/provinceInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Danh mục"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <Spinner
            android:id="@+id/categorySpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lý do giải cứu"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <Spinner
            android:id="@+id/reasonSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mức độ khẩn cấp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <Spinner
            android:id="@+id/urgencySpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hình thức giải cứu"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <Spinner
            android:id="@+id/modeSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Khoảng giá (₫)" android:textStyle="bold" android:layout_marginTop="8dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/minPriceInput"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="Từ" android:inputType="numberDecimal" />
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/maxPriceInput"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="Đến" android:inputType="numberDecimal" />
        </LinearLayout>
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/radiusInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Bán kính từ vị trí hiện tại (km)" android:inputType="numberDecimal" />
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/expiryDaysInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Chỉ lấy lô hết hạn trong N ngày" android:inputType="number" />
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/minStockInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Tồn kho tối thiểu" android:inputType="numberDecimal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sắp xếp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <Spinner
            android:id="@+id/sortSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <com.rescuefarm.ui.common.ResponsiveActionLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/applyFilterButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/apply_filter_action" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearFilterButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/clear_action" />
        </com.rescuefarm.ui.common.ResponsiveActionLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/discoveryLocationButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_use_location" />

        <TextView
            android:id="@+id/searchCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:id="@+id/searchResultContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />
    </com.rescuefarm.ui.common.ResponsiveContentLayout>
</com.rescuefarm.ui.common.NavigationAwareNestedScrollView>
