<?xml version="1.0" encoding="utf-8"?>
<com.rescuefarm.ui.common.NavigationAwareNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/checkoutScrollView" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/rescue_background" android:fillViewport="true">
    <com.rescuefarm.ui.common.ResponsiveContentLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_gravity="center_horizontal" app:maxContentWidth="@dimen/content_max_width">
        <TextView android:fontFamily="@font/ibm_plex_sans" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/checkout_title" android:textAppearance="@style/TextAppearance.RescueFarm.HeadlineMedium" android:layout_marginBottom="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Thông tin người nhận" android:textAppearance="@style/TextAppearance.RescueFarm.TitleMedium" android:textColor="@color/rescue_on_surface" android:layout_marginBottom="8dp" />
        <Spinner android:id="@+id/checkoutSavedAddressSpinner" android:layout_width="match_parent" android:layout_height="@dimen/touch_target_min" android:visibility="gone" android:contentDescription="@string/checkout_saved_address_label" android:layout_marginBottom="8dp" />
        <EditText android:id="@+id/checkoutName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/receiver_name_hint" android:background="@color/rescue_surface" android:padding="12dp" android:layout_marginBottom="8dp" />
        <EditText android:id="@+id/checkoutPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/receiver_phone_hint" android:inputType="phone" android:background="@color/rescue_surface" android:padding="12dp" android:layout_marginBottom="8dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/checkoutUseCurrentLocationButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min" android:layout_marginTop="4dp" android:layout_marginBottom="8dp" android:text="@string/checkout_use_gps_action" android:textColor="@color/rescue_primary" app:icon="@drawable/ic_home_location" app:iconTint="@color/rescue_primary" android:visibility="gone" />
        <TextView android:id="@+id/checkoutSelectedAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:visibility="gone" android:textAppearance="@style/TextAppearance.RescueFarm.BodyMedium" />
        <com.rescuefarm.ui.common.VietnamAddressView android:id="@+id/checkoutAddress" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/checkoutGpsStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp" android:text="@string/delivery_gps_required" android:textColor="@color/rescue_on_surface_variant" android:visibility="gone" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/checkout_sender_title" android:textAppearance="@style/TextAppearance.RescueFarm.TitleMedium" />
        <TextView android:id="@+id/checkoutSellerAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:text="@string/checkout_store_loading" android:textColor="@color/rescue_primary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fulfillment_label" android:textAppearance="@style/TextAppearance.RescueFarm.BodyMedium" android:textColor="@color/rescue_on_surface" android:layout_marginBottom="4dp" />
        <Spinner android:id="@+id/checkoutFulfillment" android:layout_width="match_parent" android:layout_height="@dimen/touch_target_min" android:background="@color/rescue_surface" android:padding="12dp" android:layout_marginBottom="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/payment_method_label" android:textAppearance="@style/TextAppearance.RescueFarm.BodyMedium" android:textColor="@color/rescue_on_surface" android:layout_marginBottom="4dp" />
        <Spinner android:id="@+id/checkoutPayment" android:layout_width="match_parent" android:layout_height="@dimen/touch_target_min" android:background="@color/rescue_surface" android:padding="12dp" android:layout_marginBottom="16dp" />
        <TextView android:id="@+id/checkoutPaymentStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:textColor="@color/rescue_on_surface_variant" android:textAppearance="@style/TextAppearance.RescueFarm.BodySmall" android:accessibilityLiveRegion="polite" />
        <EditText android:id="@+id/checkoutNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/order_note_hint" android:background="@color/rescue_surface" android:padding="12dp" android:minLines="3" android:gravity="top" android:layout_marginBottom="16dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tổng đơn hàng" android:textAppearance="@style/TextAppearance.RescueFarm.TitleSmall" android:textColor="@color/rescue_primary" android:layout_marginBottom="8dp" />
            <TextView android:id="@+id/checkoutSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.RescueFarm.BodyMedium" android:textColor="@color/rescue_on_surface" android:lineSpacingExtra="4dp" />
            <TextView android:id="@+id/checkoutShippingEstimate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.RescueFarm.BodyMedium" android:textColor="@color/rescue_on_surface" />
        </LinearLayout>
        <TextView android:id="@+id/checkoutMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.RescueFarm.BodySmall" android:textColor="@color/rescue_on_surface_variant" android:accessibilityLiveRegion="polite" android:layout_marginBottom="16dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/submitCheckoutButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min" android:text="@string/place_order_action" android:layout_marginBottom="16dp" />
    </com.rescuefarm.ui.common.ResponsiveContentLayout>
</com.rescuefarm.ui.common.NavigationAwareNestedScrollView>
