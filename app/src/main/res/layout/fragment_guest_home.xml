<?xml version="1.0" encoding="utf-8"?>
<com.rescuefarm.ui.common.NavigationAwareNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/rescue_background" android:fillViewport="true"
    android:focusableInTouchMode="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="12dp" android:paddingBottom="124dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/rescue_splash_green" app:cardCornerRadius="24dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/homeGreeting" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:text="@string/home_greeting_guest"
                            android:textColor="@android:color/white" android:textSize="15sp"
                            android:textStyle="bold" />
                        <LinearLayout android:id="@+id/homeLocationContainer"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="3dp" android:gravity="center_vertical"
                            android:orientation="horizontal" android:clickable="true" android:focusable="true"
                            android:background="?attr/selectableItemBackground"
                            android:paddingTop="2dp" android:paddingBottom="2dp" android:paddingEnd="6dp">
                            <TextView android:id="@+id/homeLocationLabel"
                                android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:singleLine="true"
                                android:maxLines="1" android:ellipsize="end"
                                android:drawablePadding="5dp" android:drawableStart="@drawable/ic_home_location"
                                android:gravity="center_vertical" android:text="@string/home_location_default"
                                android:textColor="@android:color/white" android:textSize="12sp" />
                            <ImageView android:layout_width="14dp" android:layout_height="14dp"
                                android:layout_marginStart="4dp" android:src="@drawable/ic_arrow_forward"
                                android:rotation="90" app:tint="@android:color/white" />
                        </LinearLayout>
                    </LinearLayout>
                    <ImageButton android:id="@+id/notificationButton" android:layout_width="42dp"
                        android:layout_height="42dp" android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/notifications_title" android:padding="9dp"
                        android:src="@drawable/ic_home_notifications" app:tint="@android:color/white" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <com.google.android.material.card.MaterialCardView android:id="@+id/searchButton"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                        app:cardBackgroundColor="@color/rescue_surface" app:cardCornerRadius="24dp" app:cardElevation="0dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                            android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="8dp">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:contentDescription="@null" android:src="@drawable/ic_home_search" app:tint="@color/rescue_primary" />
                            <androidx.appcompat.widget.AppCompatEditText android:id="@+id/homeSearchInput"
                                android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                                android:layout_marginStart="8dp" android:background="@null" android:hint="@string/home_search_hint"
                                android:inputType="text" android:imeOptions="actionSearch" android:singleLine="true"
                                android:textColor="@color/rescue_on_surface" android:textColorHint="@color/rescue_on_surface_variant" android:textSize="14sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.button.MaterialButton android:id="@+id/homeFilterButton"
                        style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp"
                        android:layout_marginStart="8dp" android:contentDescription="@string/home_filter_title"
                        app:icon="@drawable/ic_home_filter" app:iconTint="@color/rescue_primary"
                        app:backgroundTint="@color/rescue_surface" app:cornerRadius="24dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>



        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/homeMessage" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:maxLines="1" android:textColor="@color/rescue_on_surface_variant"
                android:textSize="11sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/refreshHomeButton"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                android:layout_height="36dp" android:minHeight="36dp" android:text="@string/refresh_action"
                android:textSize="12sp" />
            <ProgressBar android:id="@+id/homeProgress" style="?android:attr/progressBarStyleSmall"
                android:layout_width="20dp" android:layout_height="20dp" android:visibility="gone" />
        </LinearLayout>

        <LinearLayout android:id="@+id/categoryHomeGroup" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="24dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <TextView android:id="@+id/categoryTitle" 
                style="@style/TextAppearance.Material3.TitleMedium"
                android:layout_width="0dp" 
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Danh mục nông sản"
                android:textColor="@color/rescue_on_surface" />
            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/seeMoreCategoriesButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/see_more_action"
                android:textSize="12sp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconSize="14dp"
                app:iconGravity="end"
                app:iconPadding="4dp" />
        </LinearLayout>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:clipChildren="false" android:clipToPadding="false"
            android:fillViewport="false" android:paddingTop="6dp"
            android:paddingBottom="4dp" android:scrollbars="none">
            <LinearLayout android:id="@+id/categorySection" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:clipChildren="false"
                android:clipToPadding="false" android:orientation="horizontal" />
        </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout android:id="@+id/criticalHomeGroup" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="24dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <TextView android:id="@+id/criticalTitle" 
                style="@style/TextAppearance.Material3.TitleMedium"
                android:layout_width="0dp" 
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cần giải cứu gấp"
                android:textColor="@color/rescue_on_surface" />
            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/seeMoreCriticalButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/see_more_action"
                android:textSize="12sp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconSize="14dp"
                app:iconGravity="end"
                app:iconPadding="4dp" />
        </LinearLayout>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fillViewport="false" android:scrollbars="none">
            <LinearLayout android:id="@+id/criticalSection" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:orientation="horizontal" />
        </HorizontalScrollView>
        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2 android:id="@+id/bannerPager"
            android:layout_width="match_parent" android:layout_height="150dp"
            android:layout_marginTop="24dp" android:clipToPadding="false" />

        <LinearLayout android:id="@+id/bannerDots" android:layout_width="match_parent"
            android:layout_height="16dp" android:gravity="center"
            android:orientation="horizontal" />

        <com.google.android.material.button.MaterialButton android:id="@+id/homeNearbyLocationButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:layout_marginTop="24dp"
            android:text="Chọn vị trí để tìm điểm giải cứu gần bạn" android:textAllCaps="false"
            app:icon="@drawable/ic_home_location" app:iconTint="@color/rescue_primary"
            app:strokeColor="@color/rescue_primary" app:cornerRadius="12dp" />

        <LinearLayout android:id="@+id/nearbyMobileHomeGroup" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="24dp">
        <TextView android:id="@+id/nearbyMobileTitle" style="@style/TextAppearance.Material3.TitleMedium"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="0dp" android:text="Điểm giải cứu di động gần bạn"
            android:textColor="@color/rescue_on_surface" />
        <HorizontalScrollView android:id="@+id/nearbyMobileScroll" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:fillViewport="false" android:scrollbars="none">
            <LinearLayout android:id="@+id/nearbyMobileSection" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:orientation="horizontal" />
        </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout android:id="@+id/nearbyFixedHomeGroup" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="24dp">
        <TextView android:id="@+id/nearbyFixedTitle" style="@style/TextAppearance.Material3.TitleMedium"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="0dp" android:text="Điểm giải cứu cố định gần bạn"
            android:textColor="@color/rescue_on_surface" />
        <HorizontalScrollView android:id="@+id/nearbyFixedScroll" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:fillViewport="false" android:scrollbars="none">
            <LinearLayout android:id="@+id/nearbyFixedSection" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:orientation="horizontal" />
        </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout android:id="@+id/endingSoonHomeGroup" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="24dp">
        <TextView android:id="@+id/endingSoonTitle" style="@style/TextAppearance.Material3.TitleMedium"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="0dp" android:text="Sắp hết thời gian"
            android:textColor="@color/rescue_on_surface" />
        <HorizontalScrollView android:id="@+id/endingSoonScroll" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:fillViewport="false" android:scrollbars="none">
            <LinearLayout android:id="@+id/endingSoonSection" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:orientation="horizontal" />
        </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout android:id="@+id/nearExpiryHomeGroup" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="24dp">
        <TextView android:id="@+id/nearExpiryTitle" style="@style/TextAppearance.Material3.TitleMedium"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="0dp" android:text="Nông sản gần hết hạn"
            android:textColor="@color/rescue_on_surface" />
        <LinearLayout android:id="@+id/nearExpirySection" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout android:id="@+id/valueHomeGroup" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="24dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <TextView android:id="@+id/valueTitle"
                style="@style/TextAppearance.Material3.TitleMedium"
                android:layout_width="0dp" 
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nông sản giá tốt"
                android:textColor="@color/rescue_on_surface" />
            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/seeMoreValueButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/see_more_action"
                android:textSize="12sp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconSize="14dp"
                app:iconGravity="end"
                app:iconPadding="4dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/valueSection" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout android:id="@+id/campaignHomeGroup" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="24dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <TextView android:id="@+id/campaignTitle" 
                style="@style/TextAppearance.Material3.TitleMedium"
                android:layout_width="0dp" 
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chiến dịch đang diễn ra"
                android:textColor="@color/rescue_on_surface" />
            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/seeMoreCampaignsButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/see_more_action"
                android:textSize="12sp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconSize="14dp"
                app:iconGravity="end"
                app:iconPadding="4dp" />
        </LinearLayout>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fillViewport="false" android:scrollbars="none">
            <LinearLayout android:id="@+id/campaignSection" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:orientation="horizontal" />
        </HorizontalScrollView>
        </LinearLayout>

    </LinearLayout>
</com.rescuefarm.ui.common.NavigationAwareNestedScrollView>
