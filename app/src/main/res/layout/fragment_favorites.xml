<?xml version="1.0" encoding="utf-8"?>
<com.rescuefarm.ui.common.NavigationAwareNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rescue_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <TextView
            style="@style/TextAppearance.Material3.HeadlineMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/favorites_title"
            android:textColor="@color/rescue_on_surface"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/emptyFavoriteText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bạn chưa có sản phẩm yêu thích nào"
            android:textColor="@color/rescue_on_surface_variant"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/favoriteContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false" />
    </LinearLayout>
</com.rescuefarm.ui.common.NavigationAwareNestedScrollView>
