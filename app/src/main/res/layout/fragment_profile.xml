<?xml version="1.0" encoding="utf-8"?>
<com.rescuefarm.ui.common.NavigationAwareNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/rescue_background" android:fillViewport="true">

    <com.rescuefarm.ui.common.ResponsiveContentLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:orientation="vertical"
        android:padding="24dp" app:maxContentWidth="@dimen/reading_max_width">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/profile_title" android:fontFamily="@font/ibm_plex_sans"
            android:textSize="32sp" android:textStyle="bold"
            android:textColor="@color/rescue_on_surface" android:accessibilityHeading="true" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/profileName" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:fontFamily="@font/ibm_plex_sans"
                    android:textSize="20sp" android:textStyle="bold" android:textColor="@color/rescue_on_surface" />
                <TextView android:id="@+id/profileEmail" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:textSize="14sp" android:textColor="@color/rescue_on_surface_variant" />
                <TextView android:id="@+id/profileRole" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:textSize="14sp" android:textStyle="bold" android:textColor="@color/rescue_on_surface" />
                <TextView android:id="@+id/profileStatus" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:textSize="14sp" android:textColor="@color/rescue_on_surface_variant" />
            </LinearLayout>
            <ImageView android:id="@+id/profileAvatar" android:layout_width="72dp"
                android:layout_height="72dp" android:layout_marginStart="16dp"
                android:background="@drawable/bg_account_profile_avatar" android:clipToOutline="true"
                android:contentDescription="@string/profile_avatar_description"
                android:scaleType="centerCrop" android:src="@drawable/ic_nav_profile" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton android:id="@+id/editProfileButton"
            app:icon="@drawable/ic_profile_edit"
            style="@style/Widget.RescueFarm.AccountProfilePrimary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/edit_profile_action" />

        <com.google.android.material.button.MaterialButton android:id="@+id/addressesButton"
            app:icon="@drawable/ic_home_location"
            style="@style/Widget.RescueFarm.AccountProfileSecondary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:visibility="gone" android:text="@string/manage_addresses_action" />

        <com.google.android.material.button.MaterialButton android:id="@+id/sellerProfileButton"
            app:icon="@drawable/ic_store"
            style="@style/Widget.RescueFarm.AccountProfileSecondary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:visibility="gone" android:text="@string/seller_profile_action" />


        <com.google.android.material.button.MaterialButton android:id="@+id/favoritesButton"
            app:icon="@drawable/ic_heart"
            style="@style/Widget.RescueFarm.AccountProfileSecondary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:visibility="gone" android:text="@string/favorites_title" />

        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/notificationsButton"
            app:icon="@drawable/ic_home_notifications"
                style="@style/Widget.RescueFarm.AccountProfileSecondary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="40dp" android:paddingEnd="40dp" android:text="@string/notifications_title" />
            <TextView android:id="@+id/profileNotificationBadge"
                style="@style/Widget.RescueFarm.NotificationBadge"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical" android:layout_marginEnd="16dp"
                android:importantForAccessibility="no" android:clickable="false" android:focusable="false" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton android:id="@+id/logoutButton"
            app:icon="@drawable/ic_profile_logout"
            style="@style/Widget.RescueFarm.AccountProfileLogout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/logout_action" />

        <ProgressBar android:id="@+id/profileProgress" android:layout_width="32dp"
            android:layout_height="32dp" android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp" android:visibility="gone" />
    </com.rescuefarm.ui.common.ResponsiveContentLayout>
</com.rescuefarm.ui.common.NavigationAwareNestedScrollView>
