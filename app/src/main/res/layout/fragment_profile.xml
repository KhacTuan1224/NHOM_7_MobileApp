<?xml version="1.0" encoding="utf-8"?>
<com.rescuefarm.ui.common.NavigationAwareNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/rescue_background" android:fillViewport="true" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.rescuefarm.ui.common.ResponsiveContentLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/space_lg" android:layout_gravity="center_horizontal" app:maxContentWidth="@dimen/reading_max_width">
        <TextView android:fontFamily="@font/ibm_plex_sans" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/profile_title" android:textAppearance="@style/TextAppearance.RescueFarm.Display"
            android:textColor="@color/rescue_on_surface" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md" android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/profileName" android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.RescueFarm.SectionTitle" />
                <TextView android:id="@+id/profileEmail" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" />
                <TextView android:id="@+id/profileRole" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm"
                    android:textStyle="bold" />
                <TextView android:id="@+id/profileStatus" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm"
                    android:textColor="@color/rescue_on_surface_variant" />
            </LinearLayout>
            <ImageView android:id="@+id/profileAvatar"
                android:layout_width="76dp" android:layout_height="76dp" android:layout_marginStart="12dp"
                android:background="@drawable/bg_profile_avatar_circle" android:clipToOutline="true"
                android:contentDescription="@string/profile_avatar_description"
                android:padding="16dp" android:scaleType="centerCrop" android:src="@drawable/ic_nav_profile"
                />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/editProfileButton"
            style="@style/Widget.RescueFarm.ProfilePrimaryButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min"
            android:layout_marginStart="4dp" android:layout_marginTop="@dimen/space_lg"
            android:layout_marginEnd="4dp" android:text="@string/edit_profile_action" />
        <com.google.android.material.button.MaterialButton android:id="@+id/addressesButton"
            style="@style/Widget.RescueFarm.ProfileOutlinedButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min" android:layout_marginStart="4dp" android:layout_marginTop="@dimen/space_sm"
            android:layout_marginEnd="4dp"
            android:text="@string/manage_addresses_action" />
        <com.google.android.material.button.MaterialButton android:id="@+id/sellerProfileButton"
            style="@style/Widget.RescueFarm.ProfileOutlinedButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min" android:layout_marginStart="4dp" android:layout_marginTop="@dimen/space_sm"
            android:layout_marginEnd="4dp"
            android:text="@string/seller_profile_action" />
        <com.google.android.material.button.MaterialButton android:id="@+id/favoritesButton"
            style="@style/Widget.RescueFarm.ProfileOutlinedButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min" android:layout_marginStart="4dp"
            android:layout_marginTop="@dimen/space_sm" android:layout_marginEnd="4dp"
            android:text="@string/favorites_title" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
            android:layout_marginTop="@dimen/space_sm">
            <com.google.android.material.button.MaterialButton android:id="@+id/notificationsButton"
                style="@style/Widget.RescueFarm.ProfileOutlinedButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min"
                android:text="@string/notifications_title" />
            <TextView android:id="@+id/profileNotificationBadge"
                style="@style/Widget.RescueFarm.NotificationBadge"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical" android:layout_marginEnd="16dp" />
        </FrameLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/logoutButton"
            style="@style/Widget.RescueFarm.ProfileLogoutButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min" android:layout_marginStart="4dp"
            android:layout_marginTop="@dimen/space_md" android:layout_marginEnd="4dp"
            android:text="@string/logout_action" />
        <ProgressBar android:id="@+id/profileProgress" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_md" android:visibility="gone" />
    </com.rescuefarm.ui.common.ResponsiveContentLayout>
</com.rescuefarm.ui.common.NavigationAwareNestedScrollView>
