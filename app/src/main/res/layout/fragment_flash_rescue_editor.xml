<?xml version="1.0" encoding="utf-8"?>
<com.rescuefarm.ui.common.NavigationAwareNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@color/rescue_background" android:fillViewport="true">
    <com.rescuefarm.ui.common.ResponsiveContentLayout android:id="@+id/rescueEditorForm"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:padding="16dp" android:layout_gravity="center_horizontal" app:maxContentWidth="@dimen/content_max_width">

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" app:cardCornerRadius="22dp" app:cardElevation="0dp"
            app:cardBackgroundColor="@color/admin_products_soft" android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="GIẢI CỨU GIỜ CHÓT · TỐI ĐA 2 GIỜ" android:textSize="12sp" android:paddingBottom="8dp"
                android:textColor="@color/rescue_secondary" android:textStyle="bold" android:fontFamily="@font/ibm_plex_sans" android:accessibilityHeading="true" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <com.rescuefarm.ui.common.AppBackButton android:id="@+id/rescueEditorBack" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_vertical" android:contentDescription="@string/navigation_back" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="Mở đợt nhận nhanh" android:textSize="26sp"
                android:textColor="@color/rescue_secondary" android:textStyle="bold" android:fontFamily="@font/ibm_plex_sans" android:accessibilityHeading="true" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Ưu tiên nông sản đang cần đẩy trong thời gian ngắn. Khách gần điểm nhận có thể khám phá và chủ động bật thông báo." android:textSize="15sp" android:paddingBottom="8dp"
                android:textColor="@color/rescue_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <ProgressBar android:id="@+id/rescueEditorProgress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:visibility="gone" />
        <TextView android:id="@+id/rescueEditorMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="@color/rescue_critical" android:accessibilityLiveRegion="polite" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardCornerRadius="16dp"
            app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/rescue_outline">
            <LinearLayout android:id="@+id/flashWindow" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Còn bao lâu để giải cứu?" android:textSize="20sp" android:paddingBottom="8dp"
                android:textColor="@color/rescue_on_surface" android:textStyle="bold" android:fontFamily="@font/ibm_plex_sans" android:accessibilityHeading="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Chọn nhanh khung 15, 30 hoặc 60 phút, hoặc chạm từng mốc để chọn ngày và giờ cụ thể." android:textSize="15sp" android:paddingBottom="8dp"
                android:textColor="@color/rescue_on_surface_variant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardCornerRadius="16dp"
            app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/rescue_outline">
            <LinearLayout android:id="@+id/flashLocation" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Nhận nhanh tại đây" android:textSize="20sp" android:paddingBottom="8dp"
                android:textColor="@color/rescue_on_surface" android:textStyle="bold" android:fontFamily="@font/ibm_plex_sans" android:accessibilityHeading="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Lấy GPS tại quầy hoặc điểm đang giao nông sản để khách gần đó tìm đúng chỗ." android:textSize="15sp" android:paddingBottom="8dp"
                android:textColor="@color/rescue_on_surface_variant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardCornerRadius="16dp"
            app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/rescue_outline">
            <LinearLayout android:id="@+id/flashProduce" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Hàng đang cần bán nhanh" android:textSize="20sp" android:paddingBottom="8dp"
                android:textColor="@color/rescue_on_surface" android:textStyle="bold" android:fontFamily="@font/ibm_plex_sans" android:accessibilityHeading="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Nêu tình trạng, cách bảo quản và chọn các lô còn đủ hạn dùng." android:textSize="15sp" android:paddingBottom="8dp"
                android:textColor="@color/rescue_on_surface_variant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardCornerRadius="16dp"
            app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/rescue_outline">
            <LinearLayout android:id="@+id/flashDeal" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Chốt giá giờ chót" android:textSize="20sp" android:paddingBottom="8dp"
                android:textColor="@color/rescue_on_surface" android:textStyle="bold" android:fontFamily="@font/ibm_plex_sans" android:accessibilityHeading="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Đặt giá theo từng phần và giới hạn số phần mỗi khách. Chỉ giữ đúng lượng từ lô thật." android:textSize="15sp" android:paddingBottom="8dp"
                android:textColor="@color/rescue_on_surface_variant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:id="@+id/rescueEditorActions" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="16dp" />
    </com.rescuefarm.ui.common.ResponsiveContentLayout>
</com.rescuefarm.ui.common.NavigationAwareNestedScrollView>
