<?xml version="1.0" encoding="utf-8"?>
<com.rescuefarm.ui.common.NavigationAwareScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <com.rescuefarm.ui.common.ResponsiveContentLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/space_lg" android:layout_gravity="center_horizontal" app:maxContentWidth="@dimen/reading_max_width">
        <TextView android:id="@+id/sellerReviewReadOnlyNotice" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:visibility="gone" android:paddingTop="@dimen/space_md"
            android:text="Seller đang ở chế độ xem. Chỉ Customer đủ điều kiện mới có thể gửi đánh giá." />
        <LinearLayout android:id="@+id/reviewComposer" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:fontFamily="@font/ibm_plex_sans" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/reviews_title" android:textAppearance="@style/TextAppearance.RescueFarm.Display" />
        <TextView android:id="@+id/reviewProductSummary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="@dimen/space_xs" />
        <TextView android:id="@+id/reviewListStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="@dimen/space_sm" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md" android:text="Chọn sản phẩm từ đơn đã nhận"
            android:textAppearance="@style/TextAppearance.RescueFarm.TitleSmall" />
        <Spinner android:id="@+id/reviewEligibleOrderItem" android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_min" android:layout_marginBottom="@dimen/space_sm" />
        <EditText android:id="@+id/reviewOrderId" android:layout_width="match_parent"
            android:layout_height="0dp" android:visibility="gone" android:hint="@string/review_order_id_hint" />
        <EditText android:id="@+id/reviewOrderItemId" android:layout_width="match_parent"
            android:layout_height="0dp" android:visibility="gone" android:hint="@string/review_order_item_hint" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Chọn số sao" android:textAppearance="@style/TextAppearance.RescueFarm.TitleSmall" />
        <LinearLayout android:id="@+id/reviewRatingStars" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:layout_marginBottom="@dimen/space_sm" />
        <EditText android:id="@+id/reviewContent" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="@string/review_content_hint" />
        <com.google.android.material.button.MaterialButton android:id="@+id/uploadReviewImagesButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min"
            android:text="@string/upload_review_images_action"
            android:textColor="@color/rescue_on_surface"
            app:backgroundTint="@android:color/transparent"
            app:strokeColor="@color/rescue_primary"
            app:strokeWidth="1dp" />
        <TextView android:id="@+id/reviewImagesStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/no_images_selected" android:textSize="12sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/clearReviewImagesButton"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/clear_uploaded_images_action" />
        <EditText android:id="@+id/reviewImages" android:layout_width="0dp"
            android:layout_height="0dp" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/saveReviewButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min"
            android:text="@string/save_review_action"
            android:textColor="@color/rescue_on_surface"
            app:backgroundTint="@android:color/transparent"
            app:strokeColor="@color/rescue_primary"
            app:strokeWidth="1dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/reviewContainer" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </com.rescuefarm.ui.common.ResponsiveContentLayout>
</com.rescuefarm.ui.common.NavigationAwareScrollView>
