<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Top info row: Checkbox, Product Image, Details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cartItemCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/rescue_primary" />

        <!-- Product Image Thumbnail -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/cartItemImage"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="12dp"
            android:background="@color/rescue_background"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_placeholder_food"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

        <!-- Product Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView android:fontFamily="@font/ibm_plex_sans"
                android:id="@+id/cartItemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/rescue_on_surface"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cartItemUnitPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/rescue_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Total stays readable above quantity controls on narrow screens. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cartItemTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/rescue_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <!-- Quantity Stepper Controls [-] 1.0 kg [+] -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_quantity_stepper"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/cartItemDecrease"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Giảm số lượng"
                android:padding="14dp"
                android:src="@drawable/ic_minus" />

            <TextView
                android:id="@+id/cartItemQuantity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="36dp"
                android:gravity="center"
                android:textColor="@color/rescue_on_surface"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/cartItemIncrease"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Tăng số lượng"
                android:padding="14dp"
                android:src="@drawable/ic_plus" />
        </LinearLayout>

        <!-- Delete Item Button -->
        <ImageView
            android:id="@+id/cartItemDelete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Xóa khỏi giỏ"
            android:padding="12dp"
            android:src="@drawable/ic_trash" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider between items -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/rescue_outline" />
</LinearLayout>
