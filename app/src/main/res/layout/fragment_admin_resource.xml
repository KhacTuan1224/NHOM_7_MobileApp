<?xml version="1.0" encoding="utf-8"?>
<com.rescuefarm.ui.common.NavigationAwareNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/rescue_background" android:fillViewport="true"
    android:clipToPadding="false" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.rescuefarm.ui.common.ResponsiveContentLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/space_lg" android:layout_gravity="center_horizontal" app:maxContentWidth="@dimen/content_max_width">
        <TextView android:fontFamily="@font/ibm_plex_sans" android:id="@+id/adminResourceTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.RescueFarm.Display" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.RescueFarm.AdminOutlinedButton" android:id="@+id/adminResourceBackButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min" android:text="@string/admin_back_action"
            android:layout_marginTop="@dimen/space_sm" android:layout_marginBottom="@dimen/space_sm"
            android:insetTop="0dp" android:insetBottom="0dp" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.RescueFarm.AdminOutlinedButton" android:id="@+id/adminAddCatalogResourceButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min" android:text="@string/admin_add_catalog_resource"
            android:visibility="gone" android:layout_marginBottom="@dimen/space_sm" />
        <EditText android:id="@+id/adminModerationReason" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md"
            android:hint="@string/admin_reason_hint" android:maxLength="500"
            android:inputType="textCapSentences|textMultiLine" />
        <EditText android:id="@+id/adminSearchInput" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm"
            android:hint="Tìm theo tên, email, mã đơn hoặc ID" android:singleLine="true" />
        <com.rescuefarm.ui.common.ResponsiveActionLayout android:id="@+id/adminOrderDateFilters" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone">
            <com.google.android.material.button.MaterialButton style="@style/Widget.RescueFarm.AdminOutlinedButton" android:id="@+id/adminOrderFromDate" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:text="Từ ngày" />
            <com.google.android.material.button.MaterialButton style="@style/Widget.RescueFarm.AdminOutlinedButton" android:id="@+id/adminOrderThroughDate" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:text="Đến ngày" />
            <com.google.android.material.button.MaterialButton style="@style/Widget.RescueFarm.AdminOutlinedButton" android:id="@+id/adminOrderClearDates" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Xóa" />
        </com.rescuefarm.ui.common.ResponsiveActionLayout>
        <Spinner android:id="@+id/adminStatusFilter" android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_min" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.RescueFarm.AdminOutlinedButton" android:id="@+id/refreshAdminResourceButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min" android:text="@string/admin_refresh_action"
            android:insetTop="0dp" android:insetBottom="0dp" />
        <ProgressBar android:id="@+id/adminResourceProgress" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center_horizontal" />
        <TextView android:id="@+id/adminResourceMessage" android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <LinearLayout android:id="@+id/adminResourceContainer" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.RescueFarm.AdminOutlinedButton" android:id="@+id/loadMoreAdminItemsButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min" android:text="Tải thêm" android:visibility="gone" />
    </com.rescuefarm.ui.common.ResponsiveContentLayout>
</com.rescuefarm.ui.common.NavigationAwareNestedScrollView>
