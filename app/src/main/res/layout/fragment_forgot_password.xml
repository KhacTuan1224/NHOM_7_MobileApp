<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/rescue_surface">
    <com.rescuefarm.ui.common.NavigationAwareNestedScrollView android:id="@+id/resetRequestContainer" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <com.rescuefarm.ui.common.ResponsiveContentLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingBottom="24dp" android:layout_gravity="center_horizontal" app:maxContentWidth="@dimen/form_max_width">
            <ImageView android:layout_width="match_parent" android:layout_height="128dp" android:contentDescription="@string/login_banner_description" android:scaleType="centerCrop" android:src="@drawable/login_leaf_banner" />
            <TextView android:fontFamily="@font/ibm_plex_sans" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/auth_horizontal_margin" android:layout_marginTop="14dp" android:layout_marginEnd="@dimen/auth_horizontal_margin" android:gravity="center" android:text="@string/forgot_password_title" android:textColor="@color/rescue_on_surface" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/auth_horizontal_margin" android:layout_marginTop="4dp" android:layout_marginEnd="@dimen/auth_horizontal_margin" android:gravity="center" android:text="@string/forgot_password_body" android:textColor="@color/rescue_on_surface" android:textSize="14sp" />
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.FilledBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/auth_horizontal_margin" android:layout_marginTop="22dp" android:layout_marginEnd="@dimen/auth_horizontal_margin" android:elevation="2dp" android:hint="@string/email_label" app:boxBackgroundColor="@color/rescue_surface" app:boxStrokeWidth="0dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/emailInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:maxLines="1" android:maxLength="254" android:imeOptions="actionSend" android:autofillHints="emailAddress" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="" android:textSize="16sp" android:gravity="center" android:textColor="@color/rescue_critical" android:id="@+id/resetRequestError" android:visibility="gone" android:accessibilityLiveRegion="polite" />
            <com.rescuefarm.ui.common.ResponsiveActionLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/auth_horizontal_margin" android:layout_marginTop="28dp" android:layout_marginEnd="@dimen/auth_horizontal_margin" android:gravity="center" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/cancelResetButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min" android:layout_marginEnd="8dp" android:layout_weight="1" android:text="@string/cancel_action" android:textColor="@color/rescue_on_surface" app:cornerRadius="24dp" app:strokeColor="@color/rescue_outline" app:strokeWidth="1dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/sendResetEmailButton" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/send_reset_email_action" android:textColor="@color/rescue_on_primary" android:textStyle="bold" app:backgroundTint="@color/rescue_splash_green" app:cornerRadius="24dp" />
            </com.rescuefarm.ui.common.ResponsiveActionLayout>
            <ProgressBar android:id="@+id/authProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:contentDescription="@string/loading_content_description" android:indeterminateTint="@color/rescue_splash_green" android:visibility="gone" />
        </com.rescuefarm.ui.common.ResponsiveContentLayout>
    </com.rescuefarm.ui.common.NavigationAwareNestedScrollView>
    <com.rescuefarm.ui.common.NavigationAwareNestedScrollView android:id="@+id/resetSuccessContainer" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingStart="32dp" android:paddingEnd="32dp" android:paddingTop="24dp" android:paddingBottom="32dp">
            <ImageView android:layout_width="112dp" android:layout_height="@dimen/auth_banner_height" android:contentDescription="@string/reset_success_icon_description" android:src="@drawable/ic_reset_success" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <com.rescuefarm.ui.common.AppBackButton android:id="@+id/successBackToLoginButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_vertical" android:contentDescription="@string/back_to_login_action" />
                <TextView android:fontFamily="@font/ibm_plex_sans" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="@string/reset_email_sent_title" android:textColor="@color/rescue_on_surface" android:textSize="20sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/reset_email_sent_body" android:textColor="@color/rescue_on_surface" android:textSize="14sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/reset_sent_email_label" android:textSize="16sp" android:gravity="center" android:textColor="@color/rescue_on_surface" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="" android:textSize="16sp" android:gravity="center" android:textColor="@color/rescue_on_surface" android:id="@+id/resetSentEmail" android:textStyle="bold" android:textIsSelectable="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/reset_steps" android:textSize="16sp" android:gravity="center" android:textColor="@color/rescue_on_surface" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/reset_delivery_help" android:textSize="16sp" android:gravity="center" android:textColor="@color/rescue_on_surface" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="" android:textSize="16sp" android:gravity="center" android:textColor="@color/rescue_critical" android:id="@+id/resetSuccessError" android:visibility="gone" android:accessibilityLiveRegion="polite" />
            <ProgressBar android:id="@+id/resetResendProgress" android:layout_width="32dp" android:layout_height="32dp" android:visibility="gone" android:layout_marginTop="12dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/resetOpenEmailButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min" android:layout_marginTop="12dp" android:text="@string/reset_open_email" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/resetResendButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min" android:layout_marginTop="12dp" android:text="@string/reset_resend" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/resetChangeEmailButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min" android:layout_marginTop="12dp" android:text="@string/reset_change_email" android:textAllCaps="false" />

        </LinearLayout>
    </com.rescuefarm.ui.common.NavigationAwareNestedScrollView>
</FrameLayout>
