<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rescue_surface">

    <com.rescuefarm.ui.common.NavigationAwareNestedScrollView
        android:id="@+id/resetRequestContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <com.rescuefarm.ui.common.ResponsiveContentLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="24dp" android:layout_gravity="center_horizontal" app:maxContentWidth="@dimen/form_max_width">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="128dp"
                android:contentDescription="@string/login_banner_description"
                android:scaleType="centerCrop"
                android:src="@drawable/login_leaf_banner" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/auth_horizontal_margin"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="@dimen/auth_horizontal_margin"
                android:gravity="center"
                android:text="@string/forgot_password_title"
                android:textColor="@color/rescue_on_surface"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/auth_horizontal_margin"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="@dimen/auth_horizontal_margin"
                android:gravity="center"
                android:text="@string/forgot_password_body"
                android:textColor="@color/rescue_on_surface"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/auth_horizontal_margin"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="@dimen/auth_horizontal_margin"
                android:elevation="2dp"
                android:hint="@string/email_label"
                app:boxBackgroundColor="@color/rescue_surface"
                app:boxStrokeWidth="0dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/emailInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.rescuefarm.ui.common.ResponsiveActionLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/auth_horizontal_margin"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="@dimen/auth_horizontal_margin"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancelResetButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/cancel_action"
                    android:textColor="@color/rescue_on_surface"
                    app:cornerRadius="24dp"
                    app:strokeColor="@color/rescue_outline"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sendResetEmailButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/send_reset_email_action"
                    android:textColor="@color/rescue_on_primary"
                    android:textStyle="bold"
                    app:backgroundTint="@color/rescue_splash_green"
                    app:cornerRadius="24dp" />
            </com.rescuefarm.ui.common.ResponsiveActionLayout>

            <ProgressBar
                android:id="@+id/authProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:contentDescription="@string/loading_content_description"
                android:indeterminateTint="@color/rescue_splash_green"
                android:visibility="gone" />
        </com.rescuefarm.ui.common.ResponsiveContentLayout>
    </com.rescuefarm.ui.common.NavigationAwareNestedScrollView>

    <LinearLayout
        android:id="@+id/resetSuccessContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="112dp"
            android:layout_height="@dimen/auth_banner_height"
            android:contentDescription="@string/reset_success_icon_description"
            android:src="@drawable/ic_reset_success" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/reset_email_sent_title"
            android:textColor="@color/rescue_on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/reset_email_sent_body"
            android:textColor="@color/rescue_on_surface"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/successBackToLoginButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min"
            android:layout_marginTop="18dp"
            android:text="@string/back_to_login_action"
            android:textColor="@color/rescue_on_primary"
            android:textStyle="bold"
            app:backgroundTint="@color/rescue_splash_green"
            app:cornerRadius="24dp" />
    </LinearLayout>
</FrameLayout>
