<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="8dp"
    app:cardCornerRadius="18dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/rescue_primary_container">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/rescue_hub_title"
            android:fontFamily="@font/ibm_plex_sans" android:textAppearance="@style/TextAppearance.Material3.TitleLarge" android:textColor="@color/rescue_on_primary_container" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="@string/rescue_entry_description" android:textColor="@color/rescue_on_primary_container" />
        <com.google.android.material.button.MaterialButton android:id="@+id/openRescueProgramsButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Khám phá cách giải cứu" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
