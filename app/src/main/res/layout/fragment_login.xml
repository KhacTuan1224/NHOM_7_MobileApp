<?xml version="1.0" encoding="utf-8"?>
<com.rescuefarm.ui.common.NavigationAwareNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rescue_surface"
    android:fillViewport="true">

    <com.rescuefarm.ui.common.ResponsiveContentLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="16dp" android:layout_gravity="center_horizontal" app:maxContentWidth="@dimen/form_max_width">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/auth_banner_height"
            android:contentDescription="@string/login_banner_description"
            android:scaleType="centerCrop"
            android:src="@drawable/login_leaf_banner" />

        <TextView android:fontFamily="@font/ibm_plex_sans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/login_welcome_title"
            android:textColor="#111111"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/firebaseSetupNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auth_horizontal_margin"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/auth_horizontal_margin"
            android:background="@color/rescue_primary_container"
            android:padding="@dimen/space_md"
            android:text="@string/firebase_setup_notice"
            android:textColor="@color/rescue_on_primary_container"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/emailInputLayout"
            style="@style/Widget.Material3.TextInputLayout.FilledBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auth_horizontal_margin"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="@dimen/auth_horizontal_margin"
            android:elevation="2dp"
            android:hint="@string/email_account_label"
            app:boxBackgroundColor="@color/rescue_surface"
            app:boxStrokeColor="@color/rescue_outline"
            app:boxStrokeWidth="0dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/emailInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/passwordInputLayout"
            style="@style/Widget.Material3.TextInputLayout.FilledBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auth_horizontal_margin"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/auth_horizontal_margin"
            android:elevation="2dp"
            android:hint="@string/password_label"
            app:boxBackgroundColor="@color/rescue_surface"
            app:boxStrokeColor="@color/rescue_outline"
            app:boxStrokeWidth="0dp"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/forgotPasswordButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min"
            android:layout_gravity="end"
            android:layout_marginEnd="@dimen/auth_horizontal_margin"
            android:layout_marginTop="4dp"
            android:text="@string/forgot_password_action"
            android:textColor="@color/rescue_splash_text"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min"
            android:layout_marginStart="@dimen/auth_horizontal_margin"
            android:layout_marginEnd="@dimen/auth_horizontal_margin"
            android:text="@string/login_action"
            android:textColor="@color/rescue_on_primary"
            android:textStyle="bold"
            app:backgroundTint="@color/rescue_splash_green"
            app:cornerRadius="26dp"
            app:elevation="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginStart="@dimen/auth_horizontal_margin"
            android:layout_marginEnd="@dimen/auth_horizontal_margin"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/rescue_outline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="@string/or_separator"
                android:textColor="@color/rescue_on_surface_variant"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/rescue_outline" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/googleSignInButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min"
            android:layout_marginStart="@dimen/auth_horizontal_margin"
            android:layout_marginEnd="@dimen/auth_horizontal_margin"
            android:text="@string/google_sign_in_action"
            android:textColor="#111111"
            android:textStyle="bold"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_google_g"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconTint="@null"
            app:strokeColor="#DDE1E8"
            app:strokeWidth="1dp" />

        <com.rescuefarm.ui.common.ResponsiveActionLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/register_prompt"
                android:textColor="@color/rescue_on_surface_variant"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/registerButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min"
                android:text="@string/register_action_short"
                android:textColor="#D63D3D"
                android:textSize="12sp" />
        </com.rescuefarm.ui.common.ResponsiveActionLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/continueAsGuestButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min"
            android:layout_marginStart="@dimen/auth_horizontal_margin"
            android:layout_marginEnd="@dimen/auth_horizontal_margin"
            android:text="@string/continue_guest_action"
            android:textColor="#111111"
            android:textStyle="bold"
            app:cornerRadius="26dp"
            app:strokeColor="#DDE1E8"
            app:strokeWidth="1dp" />

        <ProgressBar
            android:id="@+id/authProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/loading_content_description"
            android:visibility="gone" />
    </com.rescuefarm.ui.common.ResponsiveContentLayout>
</com.rescuefarm.ui.common.NavigationAwareNestedScrollView>
