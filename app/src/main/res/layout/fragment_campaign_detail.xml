<?xml version="1.0" encoding="utf-8"?>
<com.rescuefarm.ui.common.NavigationAwareNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" 
    android:layout_height="match_parent"
    android:background="@color/rescue_background"
    android:fillViewport="true">
    
    <LinearLayout 
        android:layout_width="match_parent" 
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="80dp"
        android:padding="16dp">
        
        <!-- Badge text -->
        <TextView 
            android:id="@+id/campaignDetailBadge" 
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.RescueFarm.BodySmall"
            android:textColor="@color/rescue_primary"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:layout_marginBottom="8dp" />
        
        <!-- Title -->
        <TextView 
            android:id="@+id/campaignDetailTitle" 
            android:layout_width="match_parent"
            android:layout_height="wrap_content" 
            android:textAppearance="@style/TextAppearance.RescueFarm.HeadlineMedium"
            android:textColor="@color/rescue_on_surface"
            android:layout_marginBottom="8dp" />

        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" android:scrollbars="none">
            <LinearLayout android:id="@+id/campaignStoryGallery" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:orientation="horizontal" />
        </HorizontalScrollView>
        
        <!-- Reason -->
        <TextView 
            android:id="@+id/campaignDetailReason" 
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.RescueFarm.BodySmall"
            android:textColor="@color/rescue_on_surface_variant"
            android:layout_marginBottom="16dp" />
        <TextView android:id="@+id/campaignViewCount" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            android:textColor="@color/rescue_on_surface_variant" />
        
        <!-- Progress and metrics, directly on the page background -->
        <LinearLayout
            android:id="@+id/campaignProgressCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:padding="16dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tiến độ giải cứu"
                        android:textAppearance="@style/TextAppearance.RescueFarm.TitleSmall"
                        android:textColor="@color/rescue_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/campaignProgressPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.RescueFarm.TitleSmall"
                        android:textColor="@color/rescue_primary"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/campaignProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:progressTint="@color/rescue_primary"
                    android:progressBackgroundTint="@color/rescue_outline"
                    android:max="100"
                    android:layout_marginBottom="12dp" />

                <!-- 3 Metric Columns: Target, Rescued, Available -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:layout_marginBottom="4dp">

                    <!-- Target Quantity -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/campaign_target_quantity_label"
                            android:textAppearance="@style/TextAppearance.RescueFarm.BodySmall"
                            android:textColor="@color/rescue_on_surface_variant" />

                        <TextView
                            android:id="@+id/campaignTargetQuantity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/rescue_on_surface" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/rescue_outline" />

                    <!-- Rescued Quantity -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/campaign_rescued_quantity_label"
                            android:textAppearance="@style/TextAppearance.RescueFarm.BodySmall"
                            android:textColor="@color/rescue_primary" />

                        <TextView
                            android:id="@+id/campaignRescuedQuantity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/rescue_primary" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/rescue_outline" />

                    <!-- Available Quantity -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/campaign_available_quantity_label"
                            android:textAppearance="@style/TextAppearance.RescueFarm.BodySmall"
                            android:textColor="@color/rescue_critical" />

                        <TextView
                            android:id="@+id/campaignAvailableQuantity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/rescue_critical" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Compatibility Progress Text -->
                <TextView 
                    android:id="@+id/campaignDetailProgress" 
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.RescueFarm.BodySmall"
                    android:textColor="@color/rescue_on_surface_variant"
                    android:visibility="gone" />
        </LinearLayout>

        <!-- Location and rescue mode, directly on the page background -->
        <LinearLayout
            android:id="@+id/campaignLocationCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Điểm cứu trợ và Vị trí"
                    android:textAppearance="@style/TextAppearance.RescueFarm.TitleSmall"
                    android:textColor="@color/rescue_on_surface"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Rescue Mode Badge -->
                <TextView
                    android:id="@+id/campaignRescueModeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/bg_fixed_badge"
                    android:textAppearance="@style/TextAppearance.RescueFarm.BodySmall"
                    android:textColor="@color/rescue_on_primary_container"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Location Address -->
                <TextView 
                    android:id="@+id/campaignDetailLocation" 
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.RescueFarm.BodyMedium"
                    android:textColor="@color/rescue_on_surface"
                    android:layout_marginBottom="6dp" />

                <!-- Realtime Distance -->
                <TextView
                    android:id="@+id/campaignDistanceText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.RescueFarm.BodySmall"
                    android:textColor="@color/rescue_secondary"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/campaignDirectionsButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:text="Mở chỉ đường trên bản đồ"
                    style="@style/Widget.Material3.Button.OutlinedButton" />
        </LinearLayout>

        <!-- Product and purchase actions, directly on the page background -->
        <LinearLayout
            android:id="@+id/campaignProductActionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/campaign_product_section_title"
                    android:textAppearance="@style/TextAppearance.RescueFarm.TitleSmall"
                    android:textColor="@color/rescue_on_surface"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Product Information Row with Image on the left -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:id="@+id/campaignProductImage"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:contentDescription="Hình ảnh sản phẩm"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_placeholder_food" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/campaignProductName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.RescueFarm.TitleMedium"
                            android:textColor="@color/rescue_on_surface"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/campaignProductPrice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.RescueFarm.TitleMedium"
                            android:textColor="@color/rescue_primary"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/campaignBatchHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.RescueFarm.BodySmall"
                            android:textColor="@color/rescue_on_surface_variant"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Batch Selection if multiple -->
                <TextView
                    android:id="@+id/campaignBatchLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lô nông sản giải cứu:"
                    android:textAppearance="@style/TextAppearance.RescueFarm.BodySmall"
                    android:textColor="@color/rescue_on_surface_variant"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/campaignBatchSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginBottom="12dp" />

                <!-- Quantity input row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/campaign_quantity_label"
                        android:textAppearance="@style/TextAppearance.RescueFarm.BodyMedium"
                        android:textColor="@color/rescue_on_surface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/campaignQuantityDecreaseButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:padding="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:text="-"
                        android:textSize="18sp" />

                    <EditText
                        android:id="@+id/campaignQuantityInput"
                        android:layout_width="60dp"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:inputType="numberDecimal"
                        android:text="1"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_quantity_stepper"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/campaignQuantityIncreaseButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:padding="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:text="+"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/campaignQuantityUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="kg"
                        android:layout_marginStart="8dp"
                        android:textAppearance="@style/TextAppearance.RescueFarm.BodyMedium"
                        android:textColor="@color/rescue_on_surface_variant" />
                </LinearLayout>

                <!-- 2 Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/campaignAddToCartButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_target_min"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="@string/add_to_cart_action" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/campaignRescueNowButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_target_min"
                        android:layout_weight="1"
                        android:text="@string/campaign_rescue_now_action" />
                </LinearLayout>

        </LinearLayout>
        
        <!-- Schedule -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thời gian chiến dịch"
            android:textAppearance="@style/TextAppearance.RescueFarm.BodySmall"
            android:textColor="@color/rescue_on_surface_variant"
            android:layout_marginBottom="4dp" />
        
        <TextView 
            android:id="@+id/campaignDetailSchedule" 
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.RescueFarm.BodyMedium"
            android:textColor="@color/rescue_on_surface"
            android:layout_marginBottom="16dp" />
        
        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chi tiết chiến dịch"
            android:textAppearance="@style/TextAppearance.RescueFarm.TitleMedium"
            android:textColor="@color/rescue_on_surface"
            android:layout_marginBottom="8dp" />
        
        <TextView 
            android:id="@+id/campaignDetailDescription" 
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.RescueFarm.BodyMedium"
            android:textColor="@color/rescue_on_surface_variant"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Cộng đồng đồng hành" android:textAppearance="@style/TextAppearance.RescueFarm.TitleMedium" />
                <TextView android:id="@+id/campaignEngagementSummary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp" />
                <FrameLayout android:id="@+id/campaignCareButtonFrame"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/campaignCareButton"
                        style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="Quan tâm"
                        app:icon="@drawable/ic_heart" app:iconGravity="textStart"
                        app:iconTint="@color/rescue_primary" />
                </FrameLayout>
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/campaignCommentInput"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Viết bình luận về chiến dịch" android:minLines="1" android:maxLines="4" />
                <com.google.android.material.button.MaterialButton android:id="@+id/campaignSendCommentButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Gửi bình luận" />
                <LinearLayout android:id="@+id/campaignCommentContainer" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
        
        <!-- Secondary Buttons -->
        <com.google.android.material.button.MaterialButton 
            android:id="@+id/viewCampaignProductsButton"
            android:layout_width="match_parent" 
            android:layout_height="@dimen/touch_target_min"
            android:text="Xem tất cả sản phẩm trong chiến dịch"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginBottom="8dp" />
        
        <com.google.android.material.button.MaterialButton 
            android:id="@+id/shareCampaignButton"
            android:layout_width="match_parent" 
            android:layout_height="@dimen/touch_target_min"
            android:text="Chia sẻ chiến dịch"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginBottom="8dp" />
        
        <com.google.android.material.button.MaterialButton 
            android:id="@+id/reportCampaignButton"
            android:layout_width="match_parent" 
            android:layout_height="@dimen/touch_target_min"
            android:text="@string/report_action"
            style="@style/Widget.Material3.Button.TextButton" />
        
    </LinearLayout>
</com.rescuefarm.ui.common.NavigationAwareNestedScrollView>
