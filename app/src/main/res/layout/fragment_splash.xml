<?xml version="1.0" encoding="utf-8"?>
<com.rescuefarm.ui.common.NavigationAwareNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/rescue_surface">
<com.rescuefarm.ui.common.ResponsiveContentLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/rescue_surface"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp" android:layout_gravity="center_horizontal" app:maxContentWidth="@dimen/form_max_width">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="84dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="84dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/logo" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_marginTop="20dp">

        <ImageView
            android:layout_width="220dp"
            android:layout_height="162dp"
            android:layout_gravity="top|center_horizontal"
            android:contentDescription="@string/splash_illustration_description"
            android:scaleType="centerCrop"
            android:src="@drawable/splash_rescue_garden" />

        <ImageView
            android:layout_width="100dp"
            android:layout_height="87dp"
            android:layout_gravity="bottom|center_horizontal"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/logo" />
    </FrameLayout>

    <TextView android:fontFamily="@font/ibm_plex_sans"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/splash_welcome_title"
        android:textColor="@color/rescue_splash_text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/splash_welcome_body"
        android:textColor="@color/rescue_splash_text"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/splashLoginButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min"
        android:layout_marginTop="48dp"
        android:text="@string/login_action"
        android:textColor="@color/rescue_on_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/rescue_splash_green"
        app:cornerRadius="28dp"
        app:elevation="0dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/splashRegisterButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min"
        android:layout_marginTop="10dp"
        android:text="@string/create_account_action"
        android:textColor="@color/rescue_splash_text"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/rescue_surface"
        app:cornerRadius="28dp"
        app:strokeColor="@color/rescue_splash_green"
        app:strokeWidth="1dp"
        app:elevation="0dp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</com.rescuefarm.ui.common.ResponsiveContentLayout>

</com.rescuefarm.ui.common.NavigationAwareNestedScrollView>
