<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/rescue_background" android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/space_lg">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/seller_profile_title" android:textAppearance="@style/TextAppearance.RescueFarm.Display" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md" android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/sellerShopName" android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.RescueFarm.SectionTitle" />
                <TextView android:id="@+id/sellerStatus" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm"
                    android:textStyle="bold" />
                <TextView android:id="@+id/sellerBusinessRule" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm"
                    android:textColor="@color/rescue_on_surface_variant" />
            </LinearLayout>
            <ImageView android:id="@+id/sellerProfileAvatar"
                android:layout_width="76dp" android:layout_height="76dp" android:layout_marginStart="12dp"
                android:background="@drawable/bg_profile_avatar_circle" android:clipToOutline="true"
                android:contentDescription="@string/shop_avatar_description"
                android:padding="16dp" android:scaleType="centerCrop" android:src="@drawable/ic_nav_profile"
                />
        </LinearLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg" android:hint="@string/representative_label">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/sellerRepresentativeInput"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm" android:hint="@string/shop_name_label">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/sellerShopNameInput"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm" android:hint="@string/shop_description_label">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/sellerDescriptionInput"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md" android:text="@string/shop_avatar_section"
            android:textAppearance="@style/TextAppearance.RescueFarm.TitleSmall" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm" android:gravity="center_vertical" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/uploadSellerAvatarButton"
                style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min" android:text="@string/upload_shop_avatar_action" />
            <TextView android:id="@+id/sellerAvatarUploadStatus" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1" android:text="@string/no_avatar_selected" android:textSize="12sp" />
        </LinearLayout>
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/sellerAvatarInput"
            android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <com.rescuefarm.ui.common.VietnamAddressView android:id="@+id/sellerAddressInput" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md" android:text="Tài khoản nhận chuyển khoản (VietQR)"
            android:textAppearance="@style/TextAppearance.RescueFarm.TitleSmall" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm" android:hint="Mã ngân hàng VietQR (ví dụ: MB, VCB)">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/sellerBankCodeInput"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapCharacters" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm" android:hint="Tên chủ tài khoản">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/sellerBankAccountNameInput"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapCharacters" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm" android:hint="Số tài khoản">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/sellerBankAccountNumberInput"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md" android:text="Tọa độ lấy hàng của cửa hàng (để tính phí theo km)"
            android:textAppearance="@style/TextAppearance.RescueFarm.TitleSmall" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/sellerLatitudeInput"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="Vĩ độ" android:inputType="numberDecimal|numberSigned" />
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/sellerLongitudeInput"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="Kinh độ" android:inputType="numberDecimal|numberSigned" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/useSellerLocationButton"
            style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_min" android:layout_marginTop="@dimen/space_sm"
            android:text="Lấy GPS và tự điền địa chỉ" />
        <TextView android:id="@+id/sellerLocationStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="@dimen/space_xs"
            android:textColor="@color/rescue_on_surface_variant" android:textSize="12sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/saveSellerProfileButton"
            style="@style/Widget.RescueFarm.ProfilePrimaryButton"
            android:layout_width="match_parent" android:layout_height="42dp"
            android:layout_marginStart="4dp" android:layout_marginTop="@dimen/space_md"
            android:layout_marginEnd="4dp" android:text="@string/save_seller_profile_action" />
        <com.google.android.material.button.MaterialButton android:id="@+id/openSellerApplicationButton"
            style="@style/Widget.RescueFarm.ProfileOutlinedButton" android:layout_width="match_parent"
            android:layout_height="42dp" android:layout_marginStart="4dp" android:layout_marginTop="@dimen/space_sm"
            android:layout_marginEnd="4dp"
            android:text="@string/seller_application_action" />
        <com.google.android.material.button.MaterialButton android:id="@+id/openSellerDashboardButton"
            style="@style/Widget.RescueFarm.ProfileOutlinedButton" android:layout_width="match_parent"
            android:layout_height="42dp" android:layout_marginStart="4dp"
            android:layout_marginTop="@dimen/space_sm" android:layout_marginEnd="4dp"
            android:text="@string/seller_dashboard_title" />
        <com.google.android.material.button.MaterialButton android:id="@+id/openSellerProductsButton"
            style="@style/Widget.RescueFarm.ProfileOutlinedButton" android:layout_width="match_parent"
            android:layout_height="42dp" android:layout_marginStart="4dp" android:layout_marginTop="@dimen/space_sm"
            android:layout_marginEnd="4dp"
            android:text="@string/seller_products_action" />
        <com.google.android.material.button.MaterialButton android:id="@+id/openSellerCampaignsButton"
            style="@style/Widget.RescueFarm.ProfileOutlinedButton" android:layout_width="match_parent"
            android:layout_height="42dp" android:layout_marginStart="4dp" android:layout_marginTop="@dimen/space_sm"
            android:layout_marginEnd="4dp"
            android:text="@string/seller_campaigns_action" />
        <com.google.android.material.button.MaterialButton android:id="@+id/openSellerOrdersButton"
            style="@style/Widget.RescueFarm.ProfileOutlinedButton" android:layout_width="match_parent"
            android:layout_height="42dp" android:layout_marginStart="4dp" android:layout_marginTop="@dimen/space_sm"
            android:layout_marginEnd="4dp"
            android:text="@string/seller_orders_action" />
        <com.google.android.material.button.MaterialButton android:id="@+id/logoutButton"
            style="@style/Widget.RescueFarm.ProfileLogoutButton" android:layout_width="match_parent"
            android:layout_height="42dp" android:layout_marginStart="4dp"
            android:layout_marginTop="@dimen/space_lg" android:layout_marginEnd="4dp"
            android:text="@string/logout_action" />
        <View android:layout_width="match_parent" android:layout_height="96dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
