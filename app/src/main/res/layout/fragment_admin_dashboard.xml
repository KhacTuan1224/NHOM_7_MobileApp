<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/adminDashboardDrawer" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@color/rescue_background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:background="@color/rescue_surface">
            <com.google.android.material.button.MaterialButton android:id="@+id/adminDashboardMenuButton"
                style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="48dp"
                android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp"
                android:text="☰" android:textSize="24sp" android:textColor="@color/rescue_on_surface"
                android:contentDescription="Mở menu quản trị" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="RescueFarm  •  Admin" android:textStyle="bold" android:textSize="16sp"
                android:textColor="@color/rescue_on_surface" android:paddingStart="8dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/refreshAdminDashboardButton"
                style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="48dp"
                android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp"
                android:text="↻" android:textSize="24sp" android:textColor="@color/rescue_primary"
                android:contentDescription="Làm mới dashboard" />
        </LinearLayout>
        <androidx.core.widget.NestedScrollView android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"
            android:clipToPadding="false" android:paddingBottom="@dimen/admin_scroll_bottom_clearance">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="TỔNG QUAN" android:textAllCaps="true" android:textSize="12sp"
                    android:textStyle="bold" android:textColor="@color/rescue_primary" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Dashboard" android:textAppearance="@style/TextAppearance.RescueFarm.Display"
                    android:paddingTop="4dp" />
                <TextView android:id="@+id/adminDashboardMessage" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:paddingTop="8dp" android:textColor="@color/rescue_on_surface_variant" />
                <ProgressBar android:id="@+id/adminDashboardProgress" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="center_horizontal" />
                <LinearLayout android:id="@+id/adminDashboardStats" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
                <com.google.android.material.button.MaterialButton android:id="@+id/adminDashboardBackButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:layout_marginTop="16dp" android:text="Quay lại" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <LinearLayout android:layout_width="304dp" android:layout_height="match_parent"
        android:layout_gravity="start" android:orientation="vertical" android:background="@color/rescue_surface"
        android:elevation="16dp" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="RESCUEFARM" android:textSize="12sp" android:textStyle="bold"
            android:textColor="@color/rescue_primary" android:padding="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Quản trị hệ thống" android:textSize="20sp" android:textStyle="bold"
            android:textColor="@color/rescue_on_surface" android:paddingStart="12dp" android:paddingBottom="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="QUẢN LÝ" android:textSize="11sp" android:textStyle="bold"
            android:textColor="@color/rescue_on_surface_variant" android:padding="12dp" />
        <Button android:id="@+id/adminSellersButton" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="start|center_vertical" android:text="Người bán chờ duyệt" />
        <Button android:id="@+id/adminUsersButton" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="start|center_vertical" android:text="Người dùng" />
        <Button android:id="@+id/adminProductsButton" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="start|center_vertical" android:text="Sản phẩm" />
        <Button android:id="@+id/adminCampaignsButton" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="start|center_vertical" android:text="Chiến dịch cứu trợ" />
        <Button android:id="@+id/adminCategoriesButton" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="start|center_vertical" android:text="Danh mục" />
        <Button android:id="@+id/adminBannersButton" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="start|center_vertical" android:text="Banner" />
        <Button android:id="@+id/adminReviewsButton" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="start|center_vertical" android:text="Đánh giá" />
        <Button android:id="@+id/adminReportsButton" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="start|center_vertical" android:text="Báo cáo vi phạm" />
        <Button android:id="@+id/adminOrdersButton" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="start|center_vertical" android:text="Đơn hàng" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="HỆ THỐNG" android:textSize="11sp" android:textStyle="bold"
            android:textColor="@color/rescue_on_surface_variant" android:padding="12dp" />
        <Button android:id="@+id/adminAnalyticsButton" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="start|center_vertical" android:text="Phân tích" />
        <Button android:id="@+id/adminShippingSettingsButton" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="start|center_vertical" android:text="Cấu hình phí giao hàng" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
