<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/adminDashboardDrawer" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@color/rescue_background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:background="@color/rescue_surface">
            <com.google.android.material.button.MaterialButton android:id="@+id/adminDashboardMenuButton"
                style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="48dp"
                android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp"
                android:text="☰" android:textSize="24sp" android:textColor="@color/rescue_on_surface"
                android:contentDescription="Mở menu quản trị" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="RescueFarm · Quản trị" android:textStyle="bold" android:textSize="16sp"
                android:textColor="@color/rescue_on_surface" android:paddingStart="8dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/refreshAdminDashboardButton"
                style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="48dp"
                android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp"
                android:text="↻" android:textSize="24sp" android:textColor="@color/rescue_primary"
                android:contentDescription="Làm mới dashboard" />
        </LinearLayout>
        <com.rescuefarm.ui.common.NavigationAwareNestedScrollView android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"
            android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="TỔNG QUAN" android:textAllCaps="true" android:textSize="12sp"
                    android:textStyle="bold" android:textColor="@color/rescue_primary" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Tổng quan hệ thống" android:textAppearance="@style/TextAppearance.RescueFarm.Display"
                    android:paddingTop="4dp" />
                <TextView android:id="@+id/adminDashboardMessage" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:paddingTop="8dp" android:textColor="@color/rescue_on_surface_variant" />
                <ProgressBar android:id="@+id/adminDashboardProgress" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="center_horizontal" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="16dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/adminHomeSellersButton"
                        style="@style/Widget.RescueFarm.AdminOutlinedButton" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp"
                        android:layout_marginEnd="8dp" android:text="Duyệt người bán"
                        app:strokeColor="@color/admin_seller" app:iconTint="@color/admin_seller"
                        app:backgroundTint="@color/admin_seller_soft" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/adminHomeCampaignsButton"
                        style="@style/Widget.RescueFarm.AdminOutlinedButton" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp"
                        android:text="Duyệt chiến dịch" app:strokeColor="@color/admin_campaigns"
                        app:iconTint="@color/admin_campaigns" app:backgroundTint="@color/admin_campaigns_soft" />
                </LinearLayout>
                <LinearLayout android:id="@+id/adminDashboardStats" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
                <com.google.android.material.button.MaterialButton style="@style/Widget.RescueFarm.AdminOutlinedButton" android:id="@+id/adminDashboardBackButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:layout_marginTop="16dp" android:text="Quay lại" />
            </LinearLayout>
        </com.rescuefarm.ui.common.NavigationAwareNestedScrollView>
    </LinearLayout>

    <LinearLayout android:layout_width="304dp" android:layout_height="match_parent"
        android:layout_gravity="start" android:orientation="vertical" android:background="@color/rescue_surface"
        android:elevation="16dp" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="RESCUEFARM" android:textSize="12sp" android:textStyle="bold"
            android:textColor="@color/rescue_primary" android:padding="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Quản trị hệ thống" android:textSize="20sp" android:textStyle="bold"
            android:textColor="@color/rescue_on_surface" android:paddingStart="12dp" android:paddingBottom="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="QUẢN LÝ" android:textSize="11sp" android:textStyle="bold"
            android:textColor="@color/rescue_on_surface_variant" android:padding="12dp" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.RescueFarm.AdminDrawerButton" android:id="@+id/adminSellersButton" android:layout_width="220dp" android:layout_height="40dp" android:layout_marginHorizontal="8dp" android:layout_marginBottom="6dp" android:gravity="start|center_vertical" android:text="Người bán chờ duyệt" app:icon="@drawable/ic_role_seller" app:iconGravity="textStart" app:strokeColor="@color/admin_seller" app:iconTint="@color/admin_seller" app:backgroundTint="@color/admin_seller_soft" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.RescueFarm.AdminDrawerButton" android:id="@+id/adminUsersButton" android:layout_width="220dp" android:layout_height="40dp" android:layout_marginHorizontal="8dp" android:layout_marginBottom="6dp" android:gravity="start|center_vertical" android:text="Người dùng" app:icon="@drawable/ic_role_customer" app:iconGravity="textStart" app:strokeColor="@color/admin_users" app:iconTint="@color/admin_users" app:backgroundTint="@color/admin_users_soft" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.RescueFarm.AdminDrawerButton" android:id="@+id/adminProductsButton" android:layout_width="220dp" android:layout_height="40dp" android:layout_marginHorizontal="8dp" android:layout_marginBottom="6dp" android:gravity="start|center_vertical" android:text="Sản phẩm" app:icon="@drawable/ic_store" app:iconGravity="textStart" app:strokeColor="@color/admin_products" app:iconTint="@color/admin_products" app:backgroundTint="@color/admin_products_soft" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.RescueFarm.AdminDrawerButton" android:id="@+id/adminCampaignsButton" android:layout_width="220dp" android:layout_height="40dp" android:layout_marginHorizontal="8dp" android:layout_marginBottom="6dp" android:gravity="start|center_vertical" android:text="Chiến dịch cứu trợ" app:icon="@drawable/ic_nav_community" app:iconGravity="textStart" app:strokeColor="@color/admin_campaigns" app:iconTint="@color/admin_campaigns" app:backgroundTint="@color/admin_campaigns_soft" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.RescueFarm.AdminDrawerButton" android:id="@+id/adminCategoriesButton" android:layout_width="220dp" android:layout_height="40dp" android:layout_marginHorizontal="8dp" android:layout_marginBottom="6dp" android:gravity="start|center_vertical" android:text="Danh mục" app:icon="@drawable/ic_admin_categories" app:iconGravity="textStart" app:strokeColor="@color/admin_categories" app:iconTint="@color/admin_categories" app:backgroundTint="@color/admin_categories_soft" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.RescueFarm.AdminDrawerButton" android:id="@+id/adminBannersButton" android:layout_width="220dp" android:layout_height="40dp" android:layout_marginHorizontal="8dp" android:layout_marginBottom="6dp" android:gravity="start|center_vertical" android:text="Banner" app:icon="@drawable/ic_admin_banner" app:iconGravity="textStart" app:strokeColor="@color/admin_banners" app:iconTint="@color/admin_banners" app:backgroundTint="@color/admin_banners_soft" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.RescueFarm.AdminDrawerButton" android:id="@+id/adminReviewsButton" android:layout_width="220dp" android:layout_height="40dp" android:layout_marginHorizontal="8dp" android:layout_marginBottom="6dp" android:gravity="start|center_vertical" android:text="Đánh giá" app:icon="@drawable/ic_admin_review" app:iconGravity="textStart" app:strokeColor="@color/admin_reviews" app:iconTint="@color/admin_reviews" app:backgroundTint="@color/admin_reviews_soft" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.RescueFarm.AdminDrawerButton" android:id="@+id/adminReportsButton" android:layout_width="220dp" android:layout_height="40dp" android:layout_marginHorizontal="8dp" android:layout_marginBottom="6dp" android:gravity="start|center_vertical" android:text="Báo cáo vi phạm" app:icon="@drawable/ic_admin_report" app:iconGravity="textStart" app:strokeColor="@color/admin_reports" app:iconTint="@color/admin_reports" app:backgroundTint="@color/admin_reports_soft" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.RescueFarm.AdminDrawerButton" android:id="@+id/adminOrdersButton" android:layout_width="220dp" android:layout_height="40dp" android:layout_marginHorizontal="8dp" android:layout_marginBottom="6dp" android:gravity="start|center_vertical" android:text="Đơn hàng" app:icon="@drawable/ic_nav_orders" app:iconGravity="textStart" app:strokeColor="@color/admin_orders" app:iconTint="@color/admin_orders" app:backgroundTint="@color/admin_orders_soft" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="HỆ THỐNG" android:textSize="11sp" android:textStyle="bold"
            android:textColor="@color/rescue_on_surface_variant" android:padding="12dp" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.RescueFarm.AdminDrawerButton" android:id="@+id/adminAnalyticsButton" android:layout_width="220dp" android:layout_height="40dp" android:layout_marginHorizontal="8dp" android:layout_marginBottom="6dp" android:gravity="start|center_vertical" android:text="Phân tích" app:icon="@drawable/ic_nav_dashboard" app:iconGravity="textStart" app:strokeColor="@color/admin_analytics" app:iconTint="@color/admin_analytics" app:backgroundTint="@color/admin_analytics_soft" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.RescueFarm.AdminDrawerButton" android:id="@+id/adminShippingSettingsButton" android:layout_width="220dp" android:layout_height="40dp" android:layout_marginHorizontal="8dp" android:layout_marginBottom="6dp" android:gravity="start|center_vertical" android:text="Cấu hình phí giao hàng" app:icon="@drawable/ic_admin_shipping" app:iconGravity="textStart" app:strokeColor="@color/admin_shipping" app:iconTint="@color/admin_shipping" app:backgroundTint="@color/admin_shipping_soft" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
