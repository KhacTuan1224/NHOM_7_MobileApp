<?xml version="1.0" encoding="utf-8"?>
<com.rescuefarm.ui.common.NavigationAwareNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rescue_background"
    android:fillViewport="true">

    <com.rescuefarm.ui.common.ResponsiveContentLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="96dp" android:layout_gravity="center_horizontal" app:maxContentWidth="@dimen/reading_max_width">

        <!-- Top Header: Title and Clear Cart Action -->
        <com.rescuefarm.ui.common.ResponsiveActionLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView android:fontFamily="@font/ibm_plex_sans"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cart_title"
                android:textAppearance="@style/TextAppearance.RescueFarm.HeadlineMedium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cartClearButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xóa tất cả"
                android:textColor="@color/rescue_critical" />
        </com.rescuefarm.ui.common.ResponsiveActionLayout>


        <!-- Dynamic Notice / Warning Banner (Visible only when prices change or inventory issue arises) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cartNoticeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/rescue_primary_container"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/cartNoticeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:textAppearance="@style/TextAppearance.RescueFarm.BodySmall"
                android:textColor="@color/rescue_on_primary_container" />
        </com.google.android.material.card.MaterialCardView>


        <!-- Cart items grouped by seller -->
        <LinearLayout
            android:id="@+id/cartSellerGroups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/cartSummaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:lineSpacingExtra="6dp"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textColor="@color/rescue_on_surface" />

        <!-- Checkout button -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cartCheckoutButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min"
            android:backgroundTint="@color/rescue_primary"
            android:text="@string/checkout_action"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="12dp" />
    </com.rescuefarm.ui.common.ResponsiveContentLayout>
</com.rescuefarm.ui.common.NavigationAwareNestedScrollView>
