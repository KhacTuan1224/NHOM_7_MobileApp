<?xml version="1.0" encoding="utf-8"?>
<com.rescuefarm.ui.common.NavigationAwareNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/rescue_background" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.rescuefarm.ui.common.ResponsiveContentLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/space_md" android:layout_gravity="center_horizontal" app:maxContentWidth="@dimen/content_max_width">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/seller_posts_title" android:textAppearance="@style/TextAppearance.RescueFarm.Display" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/post_moderation_notice" android:textColor="@color/rescue_on_surface_variant" />
        <com.google.android.material.button.MaterialButton android:id="@+id/addPostButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/add_post_action" />
        <com.google.android.material.button.MaterialButton android:id="@+id/refreshSellerPostsButton"
            style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/refresh_action" />
        <LinearLayout android:id="@+id/sellerPostContainer" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </com.rescuefarm.ui.common.ResponsiveContentLayout>
</com.rescuefarm.ui.common.NavigationAwareNestedScrollView>
