<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rescue_background"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/space_md">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/customer_orders_title"
            android:textAppearance="@style/TextAppearance.RescueFarm.HeadlineMedium" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/refreshCustomerOrdersButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/refresh_orders_action" />
        <ProgressBar android:id="@+id/customerOrdersProgress"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:visibility="gone" />
        <TextView android:id="@+id/customerOrdersMessage"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingVertical="@dimen/space_sm" android:visibility="gone"
            android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/customerOrdersEmpty"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingVertical="@dimen/space_md" android:text="@string/customer_orders_empty" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/customerOrdersLoginButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/login_action"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/guestLookupCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/rescue_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tra cứu đơn hàng vãng lai"
                    android:textAppearance="@style/TextAppearance.RescueFarm.TitleMedium"
                    android:textColor="@color/rescue_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Dành cho khách chưa đăng nhập. Nhập mã đơn và số điện thoại nhận hàng."
                    android:textAppearance="@style/TextAppearance.RescueFarm.BodySmall"
                    android:textColor="@color/rescue_on_surface_variant" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:hint="Mã đơn hàng (VD: ORD-98234)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/lookupOrderCodeInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAllCaps="true"
                        android:inputType="textCapCharacters"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:hint="Số điện thoại nhận hàng">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/lookupReceiverPhoneInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/lookupOrderSubmitButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="Tra cứu đơn hàng" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:id="@+id/customerOrdersContainer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
