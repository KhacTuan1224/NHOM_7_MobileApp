<?xml version="1.0" encoding="utf-8"?>
<com.rescuefarm.ui.common.NavigationAwareScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rescue_background"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.rescuefarm.ui.common.ResponsiveContentLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg"
        android:layout_gravity="center_horizontal"
        app:maxContentWidth="@dimen/reading_max_width">

        <TextView android:fontFamily="@font/ibm_plex_sans"
            android:id="@+id/orderConfirmationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/order_confirmation_title"
            android:textAppearance="@style/TextAppearance.RescueFarm.Display" />

        <TextView
            android:id="@+id/orderConfirmationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/space_md" />

        <TextView android:fontFamily="@font/ibm_plex_sans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/guest_tracking_title"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/trackingOrderCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/order_code_hint" />

        <EditText
            android:id="@+id/trackingPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/receiver_phone_hint"
            android:inputType="phone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/trackOrderButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/track_order_action" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openOrderDetailButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/open_order_detail_action" />

        <LinearLayout
            android:id="@+id/recentGuestOrdersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/recentGuestOrdersTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_sans"
                android:text="@string/recent_guest_orders_title"
                android:textAppearance="@style/TextAppearance.RescueFarm.TitleMedium"
                android:textColor="@color/rescue_on_surface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/recentGuestOrdersHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/ibm_plex_sans"
                android:text="@string/recent_guest_orders_hint"
                android:textColor="@color/rescue_on_surface_variant"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/recentGuestOrdersList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </com.rescuefarm.ui.common.ResponsiveContentLayout>
</com.rescuefarm.ui.common.NavigationAwareScrollView>
