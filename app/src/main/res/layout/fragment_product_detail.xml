<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" 
    android:layout_height="match_parent" 
    android:background="@color/rescue_background"
    android:fillViewport="true">
    
    <LinearLayout 
        android:layout_width="match_parent" 
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="80dp">
        
        <!-- Image only in card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/rescue_surface">
            
            <ImageView 
                android:id="@+id/productDetailImage" 
                android:layout_width="match_parent"
                android:layout_height="280dp" 
                android:contentDescription="@string/product_image_description"
                android:scaleType="centerCrop" 
                android:background="@color/rescue_outline" />
        </com.google.android.material.card.MaterialCardView>
        
        <!-- Product info directly on background -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">
            
            <TextView 
                android:id="@+id/productDetailName" 
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.RescueFarm.HeadlineMedium"
                android:textColor="@color/rescue_on_surface" />
            
            <TextView 
                android:id="@+id/productDetailPrice" 
                android:layout_width="match_parent"
                android:layout_height="wrap_content" 
                android:layout_marginTop="8dp" 
                android:textSize="24sp"
                android:textColor="@color/rescue_primary" 
                android:textStyle="bold" />
            
            <TextView 
                android:id="@+id/productDiscount" 
                android:layout_width="match_parent"
                android:layout_height="wrap_content" 
                android:layout_marginTop="4dp"
                android:textColor="@color/rescue_critical"
                android:textStyle="bold" />
            
            <TextView 
                android:id="@+id/productDetailOrigin" 
                android:layout_width="match_parent"
                android:layout_height="wrap_content" 
                android:layout_marginTop="12dp"
                android:textAppearance="@style/TextAppearance.RescueFarm.BodyMedium"
                android:textColor="@color/rescue_on_surface_variant" />
            
            <TextView 
                android:id="@+id/productStock" 
                android:layout_width="match_parent"
                android:layout_height="wrap_content" 
                android:layout_marginTop="4dp" 
                android:textAppearance="@style/TextAppearance.RescueFarm.BodySmall"
                android:textColor="@color/rescue_on_surface_variant" />
        </LinearLayout>
        
        <!-- Price calculator in one simple card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/rescue_surface">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tính giá"
                    android:textAppearance="@style/TextAppearance.RescueFarm.TitleMedium"
                    android:textColor="@color/rescue_on_surface"
                    android:layout_marginBottom="12dp" />
                
                <LinearLayout 
                    android:layout_width="match_parent" 
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" 
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    
                    <EditText 
                        android:id="@+id/pricingQuantityInput" 
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_target_min" 
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:hint="@string/pricing_quantity_hint" 
                        android:inputType="numberDecimal"
                        android:text="1"
                        android:background="@color/rescue_primary_container"
                        android:padding="12dp" />
                    
                    <com.google.android.material.button.MaterialButton 
                        android:id="@+id/recalculatePriceButton"
                        android:layout_width="wrap_content" 
                        android:layout_height="@dimen/touch_target_min"
                        android:text="@string/recalculate_price_action"
                        style="@style/Widget.Material3.Button.TonalButton" />
                </LinearLayout>
                
                <TextView 
                    android:id="@+id/priceBreakdownText" 
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp" 
                    android:background="@color/rescue_primary_container"
                    android:textColor="@color/rescue_on_primary_container"
                    android:textAppearance="@style/TextAppearance.RescueFarm.BodySmall" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        
        <!-- Buttons directly on background -->
        <LinearLayout 
            android:layout_width="match_parent" 
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="16dp">
            
            <com.google.android.material.button.MaterialButton 
                android:id="@+id/addToCartButton"
                android:layout_width="0dp" 
                android:layout_height="@dimen/touch_target_min"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/add_to_cart_action" />
            
            <com.google.android.material.button.MaterialButton 
                android:id="@+id/openCartButton"
                style="@style/Widget.Material3.Button.OutlinedButton" 
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min" 
                android:text="@string/open_cart_action" />
        </LinearLayout>
        
        <!-- Description directly on background -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mô tả sản phẩm"
            android:textAppearance="@style/TextAppearance.RescueFarm.TitleMedium"
            android:textColor="@color/rescue_on_surface"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="8dp" />
        
        <TextView 
            android:id="@+id/productDetailDescription" 
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.RescueFarm.BodyMedium"
            android:textColor="@color/rescue_on_surface_variant"
            android:lineSpacingExtra="4dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="16dp" />
        
        <!-- Action buttons directly on background -->
        <com.google.android.material.button.MaterialButton 
            android:id="@+id/favoriteProductButton"
            android:layout_width="match_parent" 
            android:layout_height="@dimen/touch_target_min"
            android:text="@string/add_favorite_action"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp" />
        
        <com.google.android.material.button.MaterialButton 
            android:id="@+id/openReviewsButton"
            android:layout_width="match_parent" 
            android:layout_height="@dimen/touch_target_min"
            android:text="@string/reviews_title"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp" />
        
        <com.google.android.material.button.MaterialButton 
            android:id="@+id/reportProductButton"
            android:layout_width="match_parent" 
            android:layout_height="@dimen/touch_target_min"
            android:text="@string/report_action"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp" />
        
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
