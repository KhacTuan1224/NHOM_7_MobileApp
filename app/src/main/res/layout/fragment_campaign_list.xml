<?xml version="1.0" encoding="utf-8"?>
<com.rescuefarm.ui.common.NavigationAwareNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/rescue_background" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.rescuefarm.ui.common.ResponsiveContentLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/space_lg" android:layout_gravity="center_horizontal" app:maxContentWidth="@dimen/content_max_width">
        <TextView android:fontFamily="@font/ibm_plex_sans" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/campaigns_title" android:textAppearance="@style/TextAppearance.RescueFarm.Display" />
        <com.rescuefarm.ui.common.ResponsiveActionLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="@dimen/space_md">
            <Button android:id="@+id/refreshCampaignButton" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/refresh_action" />
            <Button android:id="@+id/nearbyCampaignButton" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/nearby_mobile_action" />
            <Button android:id="@+id/allCampaignButton" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/all_action" />
        </com.rescuefarm.ui.common.ResponsiveActionLayout>
        <TextView android:id="@+id/emptyCampaignText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_lg"
            android:text="@string/no_campaigns" android:visibility="gone" />
        <LinearLayout android:id="@+id/campaignContainer" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="@dimen/space_lg" />
    </com.rescuefarm.ui.common.ResponsiveContentLayout>
</com.rescuefarm.ui.common.NavigationAwareNestedScrollView>
