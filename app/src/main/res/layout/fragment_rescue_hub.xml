<?xml version="1.0" encoding="utf-8"?>
<com.rescuefarm.ui.common.NavigationAwareNestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/rescue_background" android:fillViewport="true">
    <com.rescuefarm.ui.common.ResponsiveContentLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp" android:layout_gravity="center_horizontal"
        app:maxContentWidth="@dimen/content_max_width">
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <com.rescuefarm.ui.common.AppBackButton android:id="@+id/rescueBack" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_vertical" android:contentDescription="@string/navigation_back" />
            <TextView android:id="@+id/rescueHeading" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/rescue_hub_title" android:fontFamily="@font/ibm_plex_sans"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge" android:textColor="@color/rescue_primary" />
            <com.google.android.material.button.MaterialButton android:id="@+id/rescueRefresh"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/refresh_action" />
        </LinearLayout>
        <TextView android:id="@+id/rescueIntroduction" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/rescue_hub_intro" android:textSize="18sp" android:textStyle="bold"
            android:paddingTop="12dp" android:textColor="@color/rescue_on_surface" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/rescue_hub_policy" android:paddingTop="8dp" android:paddingBottom="12dp"
            android:textColor="@color/rescue_on_surface_variant" />
        <com.google.android.material.tabs.TabLayout android:id="@+id/rescueTabs"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:tabMode="scrollable" app:tabTextColor="@color/rescue_on_surface_variant"
            app:tabSelectedTextColor="@color/rescue_primary" />
        <Spinner android:id="@+id/rescueType" android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_min" android:entries="@array/rescue_type_labels"
            android:contentDescription="Phương thức giải cứu" />
        <com.rescuefarm.ui.common.ResponsiveActionLayout android:id="@+id/rescueActions"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/rescueNearby"
                style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/rescue_nearby" />
            <com.google.android.material.button.MaterialButton android:id="@+id/rescueAlerts"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/rescue_alerts" />
        </com.rescuefarm.ui.common.ResponsiveActionLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/rescueCreate"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/rescue_create" android:visibility="gone" />
        <ProgressBar android:id="@+id/rescueProgress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true"
            android:visibility="gone" />
        <TextView android:id="@+id/rescueMessage" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:padding="12dp" android:visibility="gone"
            android:textColor="@color/rescue_on_surface_variant" android:accessibilityLiveRegion="polite" />
        <LinearLayout android:id="@+id/rescueContent" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </com.rescuefarm.ui.common.ResponsiveContentLayout>
</com.rescuefarm.ui.common.NavigationAwareNestedScrollView>
