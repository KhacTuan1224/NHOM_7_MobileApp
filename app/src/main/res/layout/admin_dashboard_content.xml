<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/adminDashboardContent" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">
        <com.rescuefarm.ui.common.ResponsiveActionLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:background="@color/rescue_surface">
            <com.google.android.material.button.MaterialButton android:id="@+id/adminDashboardMenuButton"
                style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="48dp"
                android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min" android:minWidth="0dp" android:padding="0dp"
                android:text="☰" android:textSize="24sp" android:textColor="@color/rescue_on_surface"
                android:contentDescription="Mở menu quản trị" />
            <TextView android:fontFamily="@font/ibm_plex_sans" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Quản trị hệ thống" android:textStyle="bold" android:textSize="16sp"
                android:textColor="@color/rescue_on_surface" android:paddingStart="8dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/refreshAdminDashboardButton"
                style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="48dp"
                android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min" android:minWidth="0dp" android:padding="0dp"
                android:text="↻" android:textSize="24sp" android:textColor="@color/rescue_primary"
                android:contentDescription="Làm mới dashboard" />
        </com.rescuefarm.ui.common.ResponsiveActionLayout>
        <com.rescuefarm.ui.common.NavigationAwareNestedScrollView android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"
            android:clipToPadding="false">
            <com.rescuefarm.ui.common.ResponsiveContentLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp" android:layout_gravity="center_horizontal" app:maxContentWidth="@dimen/content_max_width">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <com.rescuefarm.ui.common.AppBackButton android:id="@+id/adminDashboardBackButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_vertical" android:contentDescription="@string/navigation_back" />
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="Tổng quan hệ thống" android:textAppearance="@style/TextAppearance.RescueFarm.Detail.PageTitle"
                    android:paddingTop="4dp" />
                </LinearLayout>
                <TextView android:id="@+id/adminDashboardMessage" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:paddingTop="8dp" android:textColor="@color/rescue_on_surface_variant" />
                <ProgressBar android:id="@+id/adminDashboardProgress" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="center_horizontal" />
                <com.rescuefarm.ui.common.ResponsiveActionLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="16dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/adminHomeSellersButton"
                        style="@style/Widget.RescueFarm.AdminOutlinedButton" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp"
                        android:layout_marginEnd="8dp" android:text="Duyệt người bán"
                        app:strokeColor="@color/admin_seller" app:iconTint="@color/admin_seller"
                        app:backgroundTint="@color/admin_seller_soft" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/adminHomeCampaignsButton"
                        style="@style/Widget.RescueFarm.AdminOutlinedButton" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp"
                        android:text="Duyệt chiến dịch" app:strokeColor="@color/admin_campaigns"
                        app:iconTint="@color/admin_campaigns" app:backgroundTint="@color/admin_campaigns_soft" />
                </com.rescuefarm.ui.common.ResponsiveActionLayout>
                <LinearLayout android:id="@+id/adminDashboardStats" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />

            </com.rescuefarm.ui.common.ResponsiveContentLayout>
        </com.rescuefarm.ui.common.NavigationAwareNestedScrollView>
    </LinearLayout>
