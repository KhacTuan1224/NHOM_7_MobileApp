<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/rescue_surface" app:cardCornerRadius="4dp"
    app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/rescue_outline">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:baselineAligned="false" android:minHeight="156dp">
        <LinearLayout android:layout_width="88dp" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:padding="8dp"
            android:background="@color/rescue_primary_container">
            <ImageView android:id="@+id/voucherImage" android:layout_width="72dp" android:layout_height="88dp"
                android:scaleType="centerCrop" android:importantForAccessibility="no" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:gravity="center" android:text="@string/voucher_product_label"
                android:textSize="12sp" android:textStyle="bold" android:textColor="@color/rescue_on_primary_container" />
        </LinearLayout>
        <View android:layout_width="1dp" android:layout_height="match_parent"
            android:background="@drawable/bg_voucher_perforation" android:layerType="software" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingEnd="6dp">
                    <TextView android:id="@+id/voucherDiscount" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="20sp" android:textStyle="bold" android:textColor="@color/rescue_primary" />
                    <TextView android:id="@+id/voucherProduct" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:textSize="16sp" android:textStyle="bold"
                        android:maxLines="2" android:ellipsize="end" android:textColor="@color/rescue_on_surface" />
                    <TextView android:id="@+id/voucherSeller" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="3dp" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"
                        android:textColor="@color/rescue_on_surface_variant" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/voucherAction"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="72dp" android:layout_height="wrap_content"
                    android:minWidth="0dp" android:minHeight="48dp" android:paddingHorizontal="5dp"
                    android:paddingVertical="6dp" android:textSize="14sp" android:textAllCaps="false"
                    android:textColor="@color/rescue_primary" app:cornerRadius="3dp"
                    app:strokeColor="@color/rescue_primary" app:backgroundTint="@android:color/transparent" />
            </LinearLayout>
            <TextView android:id="@+id/voucherStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:textSize="12sp" android:textColor="@color/rescue_primary" />
            <TextView android:id="@+id/voucherExpiry" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:textSize="13sp" android:textColor="@color/rescue_on_surface_variant" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="end" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/voucherRemove"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minWidth="0dp" android:minHeight="48dp" android:paddingHorizontal="6dp"
                    android:text="@string/promotion_wallet_remove" android:textSize="13sp" android:textAllCaps="false"
                    android:textColor="@color/rescue_on_surface_variant" />
                <com.google.android.material.button.MaterialButton android:id="@+id/voucherConditions"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minWidth="0dp" android:minHeight="48dp" android:paddingHorizontal="6dp"
                    android:text="@string/voucher_conditions" android:textSize="13sp" android:textAllCaps="false"
                    android:textColor="@color/rescue_primary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
