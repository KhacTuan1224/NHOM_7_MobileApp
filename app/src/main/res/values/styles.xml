<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.RescueFarm.PublicSellerSection" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/rescue_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="TextAppearance.RescueFarm.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/ibm_plex_sans</item>
        <item name="fontFamily">@font/ibm_plex_sans</item>
    </style>

    <style name="TextAppearance.RescueFarm.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/ibm_plex_sans</item>
        <item name="fontFamily">@font/ibm_plex_sans</item>
    </style>

    <style name="TextAppearance.RescueFarm.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/ibm_plex_sans</item>
        <item name="fontFamily">@font/ibm_plex_sans</item>
    </style>

    <style name="TextAppearance.RescueFarm.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/ibm_plex_sans</item>
        <item name="fontFamily">@font/ibm_plex_sans</item>
    </style>

    <style name="TextAppearance.RescueFarm.BodyMedium" parent="TextAppearance.Material3.BodyMedium" >
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/barlow</item>
        <item name="fontFamily">@font/barlow</item>
    </style>

    <style name="TextAppearance.RescueFarm.BodySmall" parent="TextAppearance.Material3.BodySmall" >
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/barlow</item>
        <item name="fontFamily">@font/barlow</item>
    </style>

    <style name="TextAppearance.RescueFarm.SectionTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/ibm_plex_sans</item>
        <item name="fontFamily">@font/ibm_plex_sans</item>
    </style>

    <style name="TextAppearance.RescueFarm.Body" parent="TextAppearance.Material3.BodyLarge" >
        <item name="android:fontFamily">@font/barlow</item>
        <item name="fontFamily">@font/barlow</item>
    </style>

    <style name="TextAppearance.RescueFarm.Badge" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">@font/barlow</item>
        <item name="fontFamily">@font/barlow</item>
    </style>

    <style name="Widget.RescueFarm.ProfilePrimaryButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/rescue_primary</item>
        <item name="android:textColor">@color/rescue_on_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.RescueFarm.ProfileOutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/rescue_outline</item>
        <item name="android:textColor">@color/rescue_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.RescueFarm.ProfileLogoutButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/rescue_outline</item>
        <item name="android:textColor">@color/rescue_critical</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.RescueFarm.AdminDrawerButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/rescue_primary</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/rescue_on_surface</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="iconTint">@color/rescue_primary</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">8dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="Widget.RescueFarm.AdminOutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/rescue_primary</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/rescue_on_surface</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="Widget.RescueFarm.NotificationBadge" parent="Widget.AppCompat.TextView">
        <item name="android:background">@drawable/bg_notification_badge</item>
        <item name="android:fontFamily">@font/barlow</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:minWidth">20dp</item>
        <item name="android:minHeight">20dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:visibility">gone</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
    </style>
    <style name="TextAppearance.RescueFarm.CampaignDetail.Body" parent="TextAppearance.RescueFarm.Detail.Body" />
    <style name="TextAppearance.RescueFarm.CampaignDetail.Meta" parent="TextAppearance.RescueFarm.Detail.Meta" />
    <style name="TextAppearance.RescueFarm.CampaignDetail.Section" parent="TextAppearance.RescueFarm.Detail.Section" />
</resources>
