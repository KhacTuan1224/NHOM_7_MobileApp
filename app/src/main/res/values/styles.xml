<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.RescueFarm.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="TextAppearance.RescueFarm.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="TextAppearance.RescueFarm.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="TextAppearance.RescueFarm.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="TextAppearance.RescueFarm.BodyMedium" parent="TextAppearance.Material3.BodyMedium" />
    
    <style name="TextAppearance.RescueFarm.BodySmall" parent="TextAppearance.Material3.BodySmall" />

    <style name="TextAppearance.RescueFarm.SectionTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.RescueFarm.Body" parent="TextAppearance.Material3.BodyLarge" />

    <style name="TextAppearance.RescueFarm.Badge" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Widget.RescueFarm.ProfilePrimaryButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">42dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">21dp</item>
        <item name="backgroundTint">@color/rescue_primary</item>
        <item name="android:textColor">@color/rescue_on_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.RescueFarm.ProfileOutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">42dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">21dp</item>
        <item name="strokeColor">@color/rescue_outline</item>
        <item name="android:textColor">@color/rescue_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.RescueFarm.ProfileLogoutButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">42dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">21dp</item>
        <item name="strokeColor">@color/rescue_critical</item>
        <item name="android:textColor">@color/rescue_critical</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
