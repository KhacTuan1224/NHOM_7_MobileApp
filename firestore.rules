rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasRole(userId, role) {
      return isOwner(userId)
          && get(/databases/$(database)/documents/users/$(userId)).data.role == role
          && get(/databases/$(database)/documents/users/$(userId)).data.status == 'ACTIVE';
    }

    function canManageOwnAddresses(userId) {
      return isOwner(userId)
          && get(/databases/$(database)/documents/users/$(userId)).data.status == 'ACTIVE'
          && get(/databases/$(database)/documents/users/$(userId)).data.role in ['CUSTOMER', 'SELLER', 'ADMIN'];
    }

    function isApprovedSeller(userId) {
      return hasRole(userId, 'SELLER')
          && get(/databases/$(database)/documents/users/$(userId)).data.sellerStatus == 'APPROVED';
    }

    function isAdmin() {
      return isSignedIn()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'ACTIVE';
    }

    function isActiveAccount() {
      return isSignedIn()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'ACTIVE';
    }

    function hasAdminModerationFields(data) {
      return data.moderatedBy == request.auth.uid
          && data.moderatedAt == request.time
          && data.moderationReason is string
          && data.moderationReason.size() <= 500
          && data.updatedAt == request.time;
    }

    function ownsProduct(productId) {
      return isSignedIn()
          && get(/databases/$(database)/documents/products/$(productId)).data.sellerId == request.auth.uid;
    }

    function canReadBatch(batch) {
      let product = get(/databases/$(database)/documents/products/$(batch.productId)).data;
      return product.status == 'ACTIVE'
          || (isSignedIn() && product.sellerId == request.auth.uid)
          || isAdmin();
    }

    function orderReadable(order) {
      return (order.ownerType == 'CUSTOMER' && hasRole(order.ownerId, 'CUSTOMER')
              && order.ownerId == request.auth.uid)
          || (isSignedIn() && order.sellerId == request.auth.uid
              && isApprovedSeller(request.auth.uid))
          || isAdmin();
    }

    function validUserProfile(data, userId) {
      return data.keys().hasOnly([
            'id', 'email', 'fullName', 'phone', 'avatarUrl', 'avatarPublicId', 'role', 'status',
            'sellerStatus', 'customerType', 'companyName', 'taxCode',
            'representativeName', 'shopName', 'shopDescription', 'shopAvatarUrl', 'shopAvatarPublicId',
            'address', 'bankCode', 'bankAccountName', 'bankAccountNumber', 'latitude', 'longitude', 'defaultAddressId',
            'createdAt', 'updatedAt', 'moderatedBy', 'moderatedAt', 'moderationReason'
          ])
          && data.id == userId
          && data.email is string && data.email.size() <= 254
          && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100
          && data.phone is string && data.phone.size() <= 32
          && data.avatarUrl is string && data.avatarUrl.size() <= 2048
          && data.get('avatarPublicId', '') is string && data.get('avatarPublicId', '').size() <= 300
          && data.role in ['CUSTOMER', 'SELLER', 'ADMIN']
          && data.status in ['ACTIVE', 'INACTIVE', 'BLOCKED']
          && data.latitude is number && data.latitude >= -90 && data.latitude <= 90
          && data.longitude is number && data.longitude >= -180 && data.longitude <= 180
          && data.createdAt is timestamp && data.updatedAt is timestamp
          && (!data.keys().hasAny(['defaultAddressId'])
            || (data.defaultAddressId is string && data.defaultAddressId.size() <= 128))
          && (data.role != 'CUSTOMER'
            || (!data.keys().hasAny([
                  'sellerStatus', 'representativeName', 'shopName', 'shopDescription',
                  'shopAvatarUrl', 'shopAvatarPublicId', 'address',
                  'bankCode', 'bankAccountName', 'bankAccountNumber'
                ])
              && data.get('customerType', 'INDIVIDUAL') in ['INDIVIDUAL', 'BUSINESS']
              && data.get('companyName', '') is string && data.get('companyName', '').size() <= 160
              && data.get('taxCode', '') is string && data.get('taxCode', '').size() <= 40))
          && (data.role != 'SELLER'
            || (data.sellerStatus in ['PENDING_APPROVAL', 'APPROVED', 'REJECTED']
              && data.get('representativeName', '') is string
              && data.get('representativeName', '').size() <= 100
              && data.get('shopName', '') is string && data.get('shopName', '').size() <= 120
              && data.get('shopDescription', '') is string
              && data.get('shopDescription', '').size() <= 2000
              && data.get('shopAvatarUrl', '') is string
              && data.get('shopAvatarUrl', '').size() <= 2048
              && data.get('shopAvatarPublicId', '') is string && data.get('shopAvatarPublicId', '').size() <= 300
              && data.get('address', '') is string && data.get('address', '').size() <= 500
              && data.get('bankCode', '') is string && data.get('bankCode', '').size() <= 24
              && data.get('bankAccountName', '') is string && data.get('bankAccountName', '').size() <= 120
              && data.get('bankAccountNumber', '') is string && data.get('bankAccountNumber', '').size() <= 40));
    }

    function validSellerApplication(data, sellerId) {
      return data.keys().hasOnly([
            'id', 'sellerId', 'representativeName', 'shopName', 'address',
            'proofImageUrl', 'proofImagePublicId', 'status', 'rejectionReason', 'submittedAt', 'updatedAt',
            'moderatedBy', 'moderatedAt', 'moderationReason'
          ])
          && data.id == sellerId && data.sellerId == sellerId
          && data.representativeName is string && data.representativeName.size() >= 2
          && data.representativeName.size() <= 100
          && data.shopName is string && data.shopName.size() >= 2 && data.shopName.size() <= 120
          && data.address is string && data.address.size() <= 500
          && data.proofImageUrl is string && data.proofImageUrl.size() <= 2048
          && data.get('proofImagePublicId', '') is string && data.get('proofImagePublicId', '').size() <= 300
          && data.status in ['PENDING', 'APPROVED', 'REJECTED']
          && data.rejectionReason is string && data.rejectionReason.size() <= 500
          && data.submittedAt is timestamp && data.updatedAt is timestamp;
    }

    function validProduct(data) {
      return data.keys().hasOnly([
            'id', 'sellerId', 'categoryId', 'name', 'description', 'originalPrice',
            'rescuePrice', 'unit', 'origin', 'province', 'imageUrls', 'imagePublicIds', 'averageRating',
            'reviewCount', 'status', 'createdAt', 'updatedAt', 'moderatedBy',
            'moderatedAt', 'moderationReason', 'moderationPreviousStatus', 'ratingSum', 'lastReviewId'
          ])
          && data.id is string && data.sellerId is string
          && data.name is string
          && data.name.size() >= 2
          && data.name.size() <= 120
          && data.categoryId is string
          && data.categoryId.size() > 0
          && data.categoryId.size() <= 128
          && data.description is string && data.description.size() <= 3000
          && data.originalPrice is number
          && data.rescuePrice is number
          && data.originalPrice > 0
          && data.rescuePrice > 0
          && data.rescuePrice <= data.originalPrice
          && data.unit is string
          && data.unit.size() > 0 && data.unit.size() <= 40
          && data.origin is string && data.origin.size() <= 120
          && data.province is string && data.province.size() <= 120
          && data.imageUrls is list && data.imageUrls.size() <= 8
          && data.get('imagePublicIds', []) is list && data.get('imagePublicIds', []).size() <= 8
          && data.averageRating is number && data.averageRating >= 0 && data.averageRating <= 5
          && data.reviewCount is int && data.reviewCount >= 0
          && data.createdAt is timestamp && data.updatedAt is timestamp
          && data.get('moderationPreviousStatus', '') in ['', 'ACTIVE', 'INACTIVE', 'SOLD_OUT']
          && get(/databases/$(database)/documents/categories/$(data.categoryId)).data.active == true
          && data.status in ['ACTIVE', 'INACTIVE', 'SOLD_OUT', 'HIDDEN'];
    }

    function validBatch(data) {
      return data.keys().hasOnly([
            'id', 'productId', 'activeCampaignId', 'harvestDate', 'expiryDate',
            'initialQuantity', 'availableQuantity', 'reservedQuantity', 'soldQuantity',
            'status', 'inventoryVersion', 'createdAt', 'updatedAt',
            'lastReservationOrderId', 'lastReservationQuantity',
            'lastLifecycleOrderId', 'lastLifecycleAction', 'lastLifecycleQuantity', 'everOrdered'
          ])
          && data.id is string && data.productId is string
          && data.initialQuantity is number
          && data.availableQuantity is number
          && data.reservedQuantity is number
          && data.soldQuantity is number
          && data.initialQuantity > 0
          && data.availableQuantity >= 0
          && data.reservedQuantity >= 0
          && data.soldQuantity >= 0
          && data.initialQuantity
              - (data.availableQuantity + data.reservedQuantity + data.soldQuantity) <= 0.000001
          && data.initialQuantity
              - (data.availableQuantity + data.reservedQuantity + data.soldQuantity) >= -0.000001
          && data.harvestDate is timestamp
          && data.expiryDate is timestamp
          && data.harvestDate < data.expiryDate
          && data.inventoryVersion is int && data.inventoryVersion >= 1
          && data.createdAt is timestamp && data.updatedAt is timestamp
          && data.status in ['AVAILABLE', 'RESERVED_PARTIAL', 'SOLD_OUT', 'EXPIRED', 'ARCHIVED'];
    }

    function validPromotion(data, promotionId) {
      return data.id == promotionId
          && data.productId == promotionId
          && data.sellerId is string
          && data.type in ['PERCENT', 'FIXED', 'VOLUME']
          && data.value is number
          && data.value >= 0
          && (data.type == 'VOLUME' || data.value > 0)
          && (data.type != 'PERCENT' || data.value <= 100)
          && (data.type != 'VOLUME' || data.value == 0)
          && data.quantityDiscountTiers is map
          && data.quantityDiscountTiers.size() <= 10
          && (data.type != 'VOLUME' || data.quantityDiscountTiers.size() > 0)
          && data.startDate is timestamp
          && data.endDate is timestamp
          && data.startDate < data.endDate
          && data.active is bool;
    }

    function validCustomerCart(data, customerId) {
      return data.id == customerId
          && data.ownerKey == customerId
          && data.ownerType == 'CUSTOMER'
          && data.items is list
          && data.items.size() <= 100
          && data.updatedAt is timestamp
          && hasNoCredentialFields(data);
    }

    function checkoutOwnerAllowed(order) {
      return order.ownerType == 'CUSTOMER'
          && isSignedIn() && order.ownerId == request.auth.uid
          && hasRole(order.ownerId, 'CUSTOMER');
    }

    function lifecycleActor(order) {
      return (isApprovedSeller(request.auth.uid) && order.sellerId == request.auth.uid) || isAdmin();
    }

    function legalOrderStatusTransition(before, after) {
      return (before.status == 'PENDING' && after.status in ['CONFIRMED', 'CANCELLED'])
          || (before.status == 'CONFIRMED' && after.status in ['PREPARING', 'CANCELLED'])
          || (before.status == 'PREPARING' && after.status == 'CANCELLED')
          || (before.status == 'PREPARING' && before.fulfillmentType == 'DELIVERY' && after.status == 'SHIPPING')
          || (before.status == 'PREPARING' && before.fulfillmentType == 'PICKUP' && after.status == 'READY_FOR_PICKUP')
          || (before.status == 'PREPARING' && before.fulfillmentType == 'ON_SITE_RESCUE' && after.status == 'DELIVERED')
          || (before.status == 'READY_FOR_PICKUP' && after.status in ['DELIVERED', 'CANCELLED'])
          || (before.status == 'SHIPPING' && after.status == 'DELIVERED');
    }

    function validLifecyclePayment(before, after) {
      return (after.status == 'DELIVERED'
            && ((before.paymentMethod == 'BANK_TRANSFER' && before.paymentStatus == 'PAID' && after.paymentStatus == 'PAID')
              || (before.paymentMethod in ['COD', 'CASH_ON_SITE'] && after.paymentStatus == 'PAID')))
          || (after.status == 'CANCELLED' && before.paymentStatus != 'PAID' && after.paymentStatus == 'FAILED')
          || (!(after.status in ['DELIVERED', 'CANCELLED']) && after.paymentStatus == before.paymentStatus);
    }

    function lifecycleOrderUpdate(before, after) {
      let terminal = after.status in ['DELIVERED', 'CANCELLED'];
      return lifecycleActor(before) && legalOrderStatusTransition(before, after)
          && validLifecyclePayment(before, after)
          && after.inventoryFinalized == terminal
          && after.finalizedStatus == (terminal ? after.status : '')
          && after.diff(before).affectedKeys().hasOnly([
            'status', 'paymentStatus', 'inventoryFinalized', 'finalizedStatus', 'updatedAt'
          ]);
    }

    function bankConfirmationOrderUpdate(before, after) {
      return lifecycleActor(before) && before.paymentMethod == 'BANK_TRANSFER'
          && before.paymentStatus == 'PENDING' && after.paymentStatus == 'PAID'
          && before.status != 'CANCELLED' && after.status == before.status
          && after.diff(before).affectedKeys().hasOnly(['paymentStatus', 'updatedAt']);
    }

    function lifecycleBatchMutation(before, after, batchId) {
      let orderId = after.lastLifecycleOrderId;
      let oldOrder = get(/databases/$(database)/documents/orders/$(orderId)).data;
      let order = getAfter(/databases/$(database)/documents/orders/$(orderId)).data;
      let quantity = order.batchReservations[batchId];
      return lifecycleActor(oldOrder) && order.inventoryFinalized == true
          && order.status in ['DELIVERED', 'CANCELLED']
          && quantity is number && quantity > 0
          && after.reservedQuantity == before.reservedQuantity - quantity
          && after.availableQuantity == before.availableQuantity
              + (order.status == 'CANCELLED' ? quantity : 0)
          && after.soldQuantity == before.soldQuantity
              + (order.status == 'DELIVERED' ? quantity : 0)
          && after.initialQuantity == before.initialQuantity
          && after.inventoryVersion == before.inventoryVersion + 1
          && after.lastLifecycleAction == order.status
          && after.lastLifecycleQuantity == quantity
          && after.diff(before).affectedKeys().hasOnly([
            'availableQuantity', 'reservedQuantity', 'soldQuantity', 'status', 'inventoryVersion',
            'lastLifecycleOrderId', 'lastLifecycleAction', 'lastLifecycleQuantity', 'updatedAt'
          ]);
    }

    function lifecycleCampaignMutation(before, after) {
      let orderId = after.lastLifecycleOrderId;
      let oldOrder = get(/databases/$(database)/documents/orders/$(orderId)).data;
      let order = getAfter(/databases/$(database)/documents/orders/$(orderId)).data;
      let quantity = order.campaignReservedQuantity;
      return lifecycleActor(oldOrder) && order.inventoryFinalized == true
          && order.campaignId == before.id && order.status in ['DELIVERED', 'CANCELLED']
          && quantity is number && quantity > 0
          && after.reservedQuantity == before.reservedQuantity - quantity
          && after.rescuedQuantity == before.rescuedQuantity
              + (order.status == 'DELIVERED' ? quantity : 0)
          && after.lastLifecycleAction == order.status
          && after.lastLifecycleQuantity == quantity
          && after.diff(before).affectedKeys().hasOnly([
            'reservedQuantity', 'rescuedQuantity', 'status', 'lastLifecycleOrderId',
            'lastLifecycleAction', 'lastLifecycleQuantity', 'updatedAt'
          ]);
    }

    function validCampaign(data) {
      return data.keys().hasOnly([
            'id', 'sellerId', 'title', 'description', 'rescueReason', 'urgencyLevel',
            'rescueMode', 'batchTargets', 'targetQuantity', 'reservedQuantity',
            'rescuedQuantity', 'startDate', 'endDate', 'latitude', 'longitude',
            'currentLatitude', 'currentLongitude', 'locationUpdatedAt',
            'locationSharingEnabled', 'locationName', 'status', 'createdAt',
            'updatedAt', 'moderatedBy', 'moderatedAt', 'moderationReason',
            'lastReservationOrderId', 'lastReservationQuantity',
            'lastLifecycleOrderId', 'lastLifecycleAction', 'lastLifecycleQuantity',
            'imageUrls', 'imagePublicIds', 'viewCount'
          ])
          && data.id is string
          && data.sellerId is string
          && data.title is string
          && data.title.size() >= 3 && data.title.size() <= 120
          && data.description is string && data.description.size() <= 3000
          && data.get('imageUrls', []) is list && data.get('imageUrls', []).size() <= 6
          && data.get('imagePublicIds', []) is list && data.get('imagePublicIds', []).size() <= 6
          && data.get('viewCount', 0) is int && data.get('viewCount', 0) >= 0
          && data.rescueReason in [
            'OVER_SUPPLY', 'NEAR_EXPIRY', 'SEASONAL_HARVEST', 'WEATHER_IMPACT',
            'ORDER_CANCELLED', 'LOGISTICS_DISRUPTION', 'DEMAND_DROP', 'COSMETIC_GRADE'
          ]
          && data.urgencyLevel in ['NORMAL', 'HIGH', 'CRITICAL']
          && data.rescueMode in ['FIXED_POINT', 'MOBILE_POINT']
          && data.batchTargets is map
          && data.batchTargets.size() > 0
          && data.batchTargets.size() <= 8
          && data.targetQuantity is number
          && data.targetQuantity > 0 && data.targetQuantity <= 1000000000
          && data.reservedQuantity is number
          && data.rescuedQuantity is number
          && data.reservedQuantity >= 0
          && data.rescuedQuantity >= 0
          && data.reservedQuantity + data.rescuedQuantity <= data.targetQuantity + 0.000001
          && data.startDate is timestamp
          && data.endDate is timestamp
          && data.startDate < data.endDate
          && data.latitude is number
          && data.latitude >= -90 && data.latitude <= 90
          && data.longitude is number
          && data.longitude >= -180 && data.longitude <= 180
          && data.currentLatitude is number
          && data.currentLatitude >= -90 && data.currentLatitude <= 90
          && data.currentLongitude is number
          && data.currentLongitude >= -180 && data.currentLongitude <= 180
          && (data.locationUpdatedAt == null || data.locationUpdatedAt is timestamp)
          && data.locationSharingEnabled is bool
          && (data.rescueMode == 'MOBILE_POINT' || data.locationSharingEnabled == false)
          && data.locationName is string
          && data.locationName.size() <= 250
          && data.createdAt is timestamp && data.updatedAt is timestamp
          && data.status in [
            'DRAFT', 'PENDING_APPROVAL', 'ACTIVE', 'COMPLETED', 'EXPIRED', 'REJECTED', 'STOPPED'
          ];
    }

    function validPost(data) {
      return data.keys().hasOnly([
            'id', 'sellerId', 'title', 'content', 'campaignId', 'imageUrls', 'imagePublicIds',
            'linkedProductIds', 'urgencyLevel', 'status', 'viewCount',
            'createdAt', 'updatedAt', 'moderatedBy', 'moderatedAt', 'moderationReason'
          ])
          && data.id is string
          && data.sellerId is string
          && data.title is string
          && data.title.size() >= 3 && data.title.size() <= 120
          && data.content is string
          && data.content.size() >= 10 && data.content.size() <= 3000
          && data.campaignId is string
          && data.imageUrls is list && data.imageUrls.size() <= 6
          && data.get('imagePublicIds', []) is list && data.get('imagePublicIds', []).size() <= 6
          && data.linkedProductIds is list && data.linkedProductIds.size() <= 12
          && data.createdAt is timestamp
          && data.urgencyLevel in ['NORMAL', 'HIGH', 'CRITICAL']
          && data.status in ['DRAFT', 'PENDING_APPROVAL', 'PUBLISHED', 'REJECTED', 'HIDDEN']
          && data.viewCount is int && data.viewCount >= 0
          && data.createdAt is timestamp;
    }

    function publishedPost(postId) {
      return get(/databases/$(database)/documents/posts/$(postId)).data.status == 'PUBLISHED';
    }

    function validComment(data, postId) {
      return data.keys().hasOnly([
            'id', 'postId', 'userId', 'status', 'content', 'createdAt', 'updatedAt',
            'moderatedBy', 'moderatedAt', 'moderationReason'
          ])
          && data.id is string
          && data.postId == postId
          && data.userId is string
          && data.status in ['ACTIVE', 'EDITED', 'DELETED', 'HIDDEN']
          && data.content is string
          && ((data.status == 'DELETED' && data.content == '')
            || (data.status != 'DELETED' && data.content.size() >= 1 && data.content.size() <= 500))
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
    }

    function activeCampaign(campaignId) {
      return get(/databases/$(database)/documents/campaigns/$(campaignId)).data.status == 'ACTIVE';
    }

    function validCampaignComment(data, campaignId) {
      return data.keys().hasOnly([
            'id', 'campaignId', 'userId', 'status', 'content', 'createdAt', 'updatedAt',
            'moderatedBy', 'moderatedAt', 'moderationReason'
          ])
          && data.id is string && data.campaignId == campaignId
          && data.userId is string
          && data.status in ['ACTIVE', 'EDITED', 'DELETED', 'HIDDEN']
          && data.content is string
          && ((data.status == 'DELETED' && data.content == '')
            || (data.status != 'DELETED' && data.content.size() >= 1 && data.content.size() <= 500))
          && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function hasNoCredentialFields(data) {
      return !data.keys().hasAny(['password', 'passwordHash', 'rawPassword']);
    }

    function hasValidSelfRegistrationRole(data) {
      return data.role == 'CUSTOMER'
          || (data.role == 'SELLER' && data.sellerStatus == 'PENDING_APPROVAL');
    }

    function validAddress(data, userId) {
      return data.id is string && data.customerId == userId
          && data.receiverName is string
          && data.receiverName.size() >= 2
          && data.receiverName.size() <= 100
          && data.receiverPhone is string
          && data.receiverPhone.size() >= 9
          && data.receiverPhone.size() <= 32
          && data.province is string
          && data.province.size() <= 120
          && data.district is string
          && data.district.size() <= 120
          && data.ward is string
          && data.ward.size() <= 120
          && data.street is string
          && data.street.size() <= 500
          && data.type in ['HOME', 'WORK', 'OTHER']
          && data.isDefault is bool
          && data.latitude is number
          && data.latitude >= -90
          && data.latitude <= 90
          && data.longitude is number
          && data.longitude >= -180
          && data.longitude <= 180
          && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
          && request.resource.data.id == userId
          && request.resource.data.status == 'ACTIVE'
          && hasValidSelfRegistrationRole(request.resource.data)
          && validUserProfile(request.resource.data, userId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && hasNoCredentialFields(request.resource.data);

      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow update: if (isOwner(userId)
          && resource.data.status == 'ACTIVE'
          && request.resource.data.id == resource.data.id
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.get('sellerStatus', '') == resource.data.get('sellerStatus', '')
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.keys().hasOnly([
            'id', 'email', 'fullName', 'phone', 'avatarUrl', 'avatarPublicId', 'role', 'status',
            'sellerStatus', 'customerType', 'companyName', 'taxCode',
            'representativeName', 'shopName', 'shopDescription', 'shopAvatarUrl', 'shopAvatarPublicId',
            'address', 'bankCode', 'bankAccountName', 'bankAccountNumber', 'latitude', 'longitude', 'defaultAddressId', 'createdAt',
            'updatedAt', 'moderatedBy', 'moderatedAt', 'moderationReason'
          ])
          && request.resource.data.updatedAt == request.time
          // Owners may keep an existing review, but cannot add, edit or remove its audit fields.
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'moderatedBy', 'moderatedAt', 'moderationReason'
          ])
          && validUserProfile(request.resource.data, userId)
          && (resource.data.role != 'SELLER'
              || request.resource.data.sellerStatus == resource.data.sellerStatus)
          && (resource.data.role == 'SELLER'
              || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                'representativeName', 'shopName', 'shopDescription', 'shopAvatarUrl', 'shopAvatarPublicId', 'address',
                'bankCode', 'bankAccountName', 'bankAccountNumber'
              ]))
          && hasNoCredentialFields(request.resource.data))
        || (isAdmin()
          && resource.data.role != 'ADMIN'
          && request.resource.data.id == resource.data.id
          && request.resource.data.role == resource.data.role
          && ((request.resource.data.status == resource.data.status
                && resource.data.role == 'SELLER'
                && request.resource.data.sellerStatus in ['APPROVED', 'REJECTED']
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'sellerStatus', 'moderatedBy', 'moderatedAt',
                  'moderationReason', 'updatedAt'
                ]))
            || (((resource.data.status in ['ACTIVE', 'INACTIVE']
                    && request.resource.data.status == 'BLOCKED')
                  || (resource.data.status == 'BLOCKED'
                    && request.resource.data.status == 'ACTIVE'))
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'status', 'moderatedBy', 'moderatedAt',
                  'moderationReason', 'updatedAt'
                ])))
          && (request.resource.data.status != 'BLOCKED'
            || request.resource.data.moderationReason.size() >= 3)
          && hasAdminModerationFields(request.resource.data)
          && validUserProfile(request.resource.data, userId)
          && hasNoCredentialFields(request.resource.data));

      allow delete: if false;

      match /addresses/{addressId} {
        allow get, list: if canManageOwnAddresses(userId);
        allow create: if canManageOwnAddresses(userId)
            && request.resource.data.keys().hasOnly([
              'id', 'customerId', 'receiverName', 'receiverPhone', 'province',
              'district', 'ward', 'street', 'latitude', 'longitude', 'type',
              'isDefault', 'updatedAt'
            ])
            && request.resource.data.id == addressId
            && validAddress(request.resource.data, userId)
            && request.resource.data.updatedAt == request.time
            && hasNoCredentialFields(request.resource.data);
        allow update: if canManageOwnAddresses(userId)
            && request.resource.data.keys().hasOnly([
              'id', 'customerId', 'receiverName', 'receiverPhone', 'province',
              'district', 'ward', 'street', 'latitude', 'longitude', 'type',
              'isDefault', 'updatedAt'
            ])
            && request.resource.data.id == resource.data.id
            && request.resource.data.customerId == resource.data.customerId
            && validAddress(request.resource.data, userId)
            && request.resource.data.updatedAt == request.time
            && hasNoCredentialFields(request.resource.data);
        allow delete: if canManageOwnAddresses(userId) && resource.data.isDefault == false;
      }
      match /devices/{deviceId} {
        allow get, list: if hasRole(userId, 'CUSTOMER') || hasRole(userId, 'SELLER');
        allow create, update: if (hasRole(userId, 'CUSTOMER') || hasRole(userId, 'SELLER'))
            && request.resource.data.keys().hasOnly(['userId', 'token', 'platform', 'updatedAt'])
            && request.resource.data.userId == userId
            && request.resource.data.token is string
            && request.resource.data.token.size() > 20
            && request.resource.data.token.size() <= 4096
            && request.resource.data.platform == 'ANDROID'
            && request.resource.data.updatedAt == request.time;
        allow delete: if hasRole(userId, 'CUSTOMER') || hasRole(userId, 'SELLER');
      }
    }

    match /sellerPublicProfiles/{sellerId} {
      // Historical documents stay unreadable until the backend migrates payment fields out.
      allow get: if !exists(/databases/$(database)/documents/sellerPublicProfiles/$(sellerId))
          || !resource.data.keys().hasAny([
              'bankCode', 'bankAccountName', 'bankAccountNumber', 'qrUrl'
            ]);
      allow list: if isAdmin();
      allow create, update: if hasRole(sellerId, 'SELLER')
          && request.auth.uid == sellerId
          && request.resource.data.keys().hasOnly([
            'sellerId', 'shopName', 'shopDescription', 'shopAvatarUrl', 'address',
            'latitude', 'longitude', 'shippingFee', 'updatedAt'
          ])
          && request.resource.data.sellerId == sellerId
          && request.resource.data.shopName is string && request.resource.data.shopName.size() <= 120
          && request.resource.data.shopDescription is string && request.resource.data.shopDescription.size() <= 2000
          && request.resource.data.shopAvatarUrl is string && request.resource.data.shopAvatarUrl.size() <= 2048
          && request.resource.data.address is string && request.resource.data.address.size() <= 500
          && request.resource.data.latitude is number && request.resource.data.latitude >= -90
          && request.resource.data.latitude <= 90
          && request.resource.data.longitude is number && request.resource.data.longitude >= -180
          && request.resource.data.longitude <= 180
          && request.resource.data.get('shippingFee', 0) is number
          && request.resource.data.get('shippingFee', 0) >= 0 && request.resource.data.get('shippingFee', 0) <= 1000000
          && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin() || (request.auth.uid == sellerId && hasRole(sellerId, 'SELLER'));
    }

    match /sellerPaymentProfiles/{sellerId} {
      allow get: if request.auth != null
          && (request.auth.uid == sellerId && hasRole(sellerId, 'SELLER') || isAdmin());
      allow list: if isAdmin();
      // Active sellers can prepare their own profile before approval; selling still requires approval.
      allow create, update: if hasRole(sellerId, 'SELLER')
          && request.auth.uid == sellerId
          && request.resource.data.keys().hasOnly([
            'sellerId', 'bankCode', 'bankAccountName', 'bankAccountNumber', 'qrUrl', 'updatedAt'
          ])
          && request.resource.data.sellerId == sellerId
          && request.resource.data.bankCode is string && request.resource.data.bankCode.size() <= 24
          && request.resource.data.bankAccountName is string && request.resource.data.bankAccountName.size() <= 120
          && request.resource.data.bankAccountNumber is string && request.resource.data.bankAccountNumber.size() <= 40
          && request.resource.data.get('qrUrl', '') is string && request.resource.data.get('qrUrl', '').size() <= 2048
          && (request.resource.data.get('qrUrl', '') == '' || request.resource.data.qrUrl.matches('https://.*'))
          && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /appConfig/shipping {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isAdmin()
          && request.resource.data.keys().hasOnly(['baseFeeVnd', 'perKmFeeVnd', 'freeDistanceKm', 'updatedBy', 'updatedAt'])
          && request.resource.data.baseFeeVnd is number && request.resource.data.baseFeeVnd >= 0
          && request.resource.data.baseFeeVnd <= 1000000
          && request.resource.data.perKmFeeVnd is number && request.resource.data.perKmFeeVnd >= 0
          && request.resource.data.perKmFeeVnd <= 1000000
          && request.resource.data.freeDistanceKm is number && request.resource.data.freeDistanceKm >= 0
          && request.resource.data.freeDistanceKm <= 20040
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /sellerApplications/{sellerId} {
      allow get: if hasRole(sellerId, 'SELLER') || isAdmin();
      allow list: if isAdmin();
      allow create: if hasRole(sellerId, 'SELLER')
          && validSellerApplication(request.resource.data, sellerId)
          && request.resource.data.status == 'PENDING'
          && request.resource.data.submittedAt == request.time
          && request.resource.data.updatedAt == request.time
          && hasNoCredentialFields(request.resource.data);
      allow update: if (hasRole(sellerId, 'SELLER')
          && resource.data.status == 'REJECTED'
          && validSellerApplication(request.resource.data, sellerId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.status == 'PENDING'
          && request.resource.data.submittedAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'representativeName', 'shopName', 'address', 'proofImageUrl', 'proofImagePublicId',
            'status', 'rejectionReason', 'submittedAt', 'updatedAt'
          ])
          && hasNoCredentialFields(request.resource.data))
        || (isAdmin()
          && validSellerApplication(request.resource.data, sellerId)
          && resource.data.status == 'PENDING'
          && request.resource.data.status in ['APPROVED', 'REJECTED']
          && request.resource.data.id == resource.data.id
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'rejectionReason', 'moderatedBy', 'moderatedAt',
            'moderationReason', 'updatedAt'
          ])
          && getAfter(/databases/$(database)/documents/users/$(sellerId)).data.sellerStatus
              == request.resource.data.status
          && (request.resource.data.status != 'REJECTED'
            || request.resource.data.moderationReason.size() >= 3)
          && hasAdminModerationFields(request.resource.data)
          && hasNoCredentialFields(request.resource.data));
      allow delete: if false;
    }

    function validAdminCategory(data, categoryId) {
      return data.keys().hasOnly([
            'id', 'name', 'description', 'imageUrl', 'imagePublicId', 'active', 'displayOrder',
            'createdAt', 'updatedAt', 'moderatedBy', 'moderatedAt', 'moderationReason'
          ])
          && data.id == categoryId
          && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
          && data.get('description', '') is string && data.get('description', '').size() <= 500
          && data.imageUrl is string && data.imageUrl.size() <= 2048
          && (data.imageUrl == '' || data.imageUrl.matches('https://res\\.cloudinary\\.com/.+'))
          && data.get('imagePublicId', '') is string && data.get('imagePublicId', '').size() <= 300
          && data.active is bool
          && data.displayOrder is int && data.displayOrder >= 0 && data.displayOrder <= 10000
          && data.get('createdAt', request.time) is timestamp
          && data.updatedAt == request.time;
    }

    match /categories/{categoryId} {
      allow get, list: if resource.data.active == true || isAdmin();
      allow create: if isAdmin()
          && validAdminCategory(request.resource.data, categoryId)
          && request.resource.data.createdAt == request.time
          && hasAdminModerationFields(request.resource.data);
      allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'description', 'imageUrl', 'imagePublicId', 'active', 'displayOrder',
            'updatedAt', 'moderatedBy', 'moderatedAt', 'moderationReason'
          ])
          && validAdminCategory(request.resource.data, categoryId)
          && (request.resource.data.active == true
            || request.resource.data.moderationReason.size() >= 3)
          && hasAdminModerationFields(request.resource.data);
      allow delete: if false;
    }

    function reviewSummaryWritten(productId, reviewId) {
      let product = getAfter(/databases/$(database)/documents/products/$(productId)).data;
      return product.lastReviewId == reviewId && product.updatedAt == request.time;
    }

    function validReviewSummaryChange(before, after, productId) {
      let reviewId = after.lastReviewId;
      let reviewPath = /databases/$(database)/documents/reviews/$(reviewId);
      let next = getAfter(reviewPath).data;
      let oldPublished = exists(reviewPath) && get(reviewPath).data.status == 'PUBLISHED';
      let nextPublished = next.status == 'PUBLISHED';
      let oldRating = oldPublished ? get(reviewPath).data.rating : 0;
      let nextRating = nextPublished ? next.rating : 0;
      let count = before.reviewCount + (nextPublished ? 1 : 0) - (oldPublished ? 1 : 0);
      let sum = before.get('ratingSum', before.averageRating * before.reviewCount) + nextRating - oldRating;
      return (isOwner(next.customerId) && hasRole(next.customerId, 'CUSTOMER') || isAdmin())
          && next.productId == productId && next.updatedAt == request.time
          && after.reviewCount == count && count >= 0
          && after.ratingSum == sum && sum >= 0 && sum <= count * 5
          && after.averageRating == (count == 0 ? 0 : sum / (count * 1.0))
          && after.updatedAt == request.time
          && after.diff(before).affectedKeys().hasOnly(['reviewCount', 'ratingSum', 'averageRating', 'lastReviewId', 'updatedAt']);
    }

    match /products/{productId} {
      allow get, list: if resource.data.status == 'ACTIVE'
          || (isSignedIn() && resource.data.sellerId == request.auth.uid) || isAdmin();
      allow create: if isApprovedSeller(request.auth.uid)
          && request.resource.data.id == productId
          && request.resource.data.sellerId == request.auth.uid
          && request.resource.data.averageRating == 0
          && request.resource.data.reviewCount == 0
          && validProduct(request.resource.data)
          && hasNoCredentialFields(request.resource.data);
      allow update: if (isApprovedSeller(request.auth.uid)
          && resource.data.sellerId == request.auth.uid
          && resource.data.status != 'HIDDEN'
          && request.resource.data.id == resource.data.id
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.averageRating == resource.data.averageRating
          && request.resource.data.reviewCount == resource.data.reviewCount
          && request.resource.data.get('ratingSum', 0) == resource.data.get('ratingSum', 0)
          && request.resource.data.get('lastReviewId', '') == resource.data.get('lastReviewId', '')
          && request.resource.data.get('moderationPreviousStatus', '')
              == resource.data.get('moderationPreviousStatus', '')
          && validProduct(request.resource.data)
          && hasNoCredentialFields(request.resource.data))
        || (isAdmin()
          && request.resource.data.id == resource.data.id
          && request.resource.data.sellerId == resource.data.sellerId
          && ((resource.data.status in ['ACTIVE', 'INACTIVE', 'SOLD_OUT']
                && request.resource.data.status == 'HIDDEN'
                && request.resource.data.moderationPreviousStatus == resource.data.status)
            || (resource.data.status == 'HIDDEN'
                && request.resource.data.status == resource.data.get('moderationPreviousStatus', 'INACTIVE')
                && request.resource.data.get('moderationPreviousStatus', '') == ''))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'moderatedBy', 'moderatedAt', 'moderationReason',
            'moderationPreviousStatus', 'updatedAt'
          ])
          && validProduct(request.resource.data)
          && (request.resource.data.status != 'HIDDEN'
            || request.resource.data.moderationReason.size() >= 3)
          && hasAdminModerationFields(request.resource.data)
          && hasNoCredentialFields(request.resource.data))
        || validReviewSummaryChange(resource.data, request.resource.data, productId);
      allow delete: if false;
    }

    match /productBatches/{batchId} {
      allow get, list: if canReadBatch(resource.data);
      allow create: if isApprovedSeller(request.auth.uid)
          && ownsProduct(request.resource.data.productId)
          && request.resource.data.id == batchId
          && request.resource.data.inventoryVersion == 1
          && validBatch(request.resource.data)
          && hasNoCredentialFields(request.resource.data);
      allow update: if (isApprovedSeller(request.auth.uid)
            && ownsProduct(resource.data.productId)
            && request.resource.data.id == resource.data.id
            && request.resource.data.productId == resource.data.productId
            && request.resource.data.inventoryVersion == resource.data.inventoryVersion + 1
            && validBatch(request.resource.data)
            && resource.data.reservedQuantity == 0
            && resource.data.soldQuantity == 0
            && resource.data.availableQuantity == resource.data.initialQuantity
            && request.resource.data.reservedQuantity == 0
            && request.resource.data.soldQuantity == 0
            && request.resource.data.availableQuantity == request.resource.data.initialQuantity
            && (!resource.data.get('everOrdered', false)
              || (request.resource.data.status == 'ARCHIVED'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'inventoryVersion', 'updatedAt'])))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'harvestDate', 'expiryDate', 'initialQuantity', 'availableQuantity',
              'status', 'inventoryVersion', 'updatedAt'
            ])
            && hasNoCredentialFields(request.resource.data))
          || (lifecycleBatchMutation(resource.data, request.resource.data, batchId)
            && validBatch(request.resource.data))
          || (isAdmin()
            && resource.data.activeCampaignId is string
            && resource.data.activeCampaignId.size() > 0
            && get(/databases/$(database)/documents/campaigns/$(resource.data.activeCampaignId)).data.status == 'ACTIVE'
            && getAfter(/databases/$(database)/documents/campaigns/$(resource.data.activeCampaignId)).data.status == 'STOPPED'
            && request.resource.data.activeCampaignId == null
            && request.resource.data.inventoryVersion == resource.data.inventoryVersion + 1
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'activeCampaignId', 'inventoryVersion', 'updatedAt'
            ])
            && validBatch(request.resource.data));
      // Keep batch references valid for delivered AND cancelled orders. Archive instead.
      allow delete: if false;
    }

    match /promotions/{promotionId} {
      // Checkout reads by product ID even when no promotion exists or it has expired.
      // Only active customers may use this path, for products currently on sale.
      allow get: if (isSignedIn() && hasRole(request.auth.uid, 'CUSTOMER')
            && exists(/databases/$(database)/documents/products/$(promotionId))
            && get(/databases/$(database)/documents/products/$(promotionId)).data.status == 'ACTIVE')
          || (resource.data.active == true
            && resource.data.startDate <= request.time
            && resource.data.endDate > request.time)
          || (isSignedIn() && resource.data.sellerId == request.auth.uid)
          || isAdmin();
      allow list: if (resource.data.active == true
            && resource.data.startDate <= request.time
            && resource.data.endDate > request.time)
          || (isSignedIn() && resource.data.sellerId == request.auth.uid)
          || isAdmin();
      allow create: if isApprovedSeller(request.auth.uid)
          && promotionId == request.resource.data.productId
          && request.resource.data.sellerId == request.auth.uid
          && ownsProduct(request.resource.data.productId)
          && validPromotion(request.resource.data, promotionId)
          && hasNoCredentialFields(request.resource.data);
      allow update: if isApprovedSeller(request.auth.uid)
          && resource.data.sellerId == request.auth.uid
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.productId == resource.data.productId
          && ownsProduct(resource.data.productId)
          && validPromotion(request.resource.data, promotionId)
          && hasNoCredentialFields(request.resource.data);
      allow delete: if false;
    }

    match /customerCarts/{customerId} {
      allow get: if hasRole(customerId, 'CUSTOMER');
      allow list: if false;
      allow create, update: if hasRole(customerId, 'CUSTOMER')
          && validCustomerCart(request.resource.data, customerId);
      allow delete: if hasRole(customerId, 'CUSTOMER');
    }

    match /orders/{orderId} {
      // The first transaction read checks whether this checkout was already processed.
      // A missing order has no owner yet; existing orders still require ownership.
      allow get: if (isSignedIn() && hasRole(request.auth.uid, 'CUSTOMER')
            && !exists(/databases/$(database)/documents/orders/$(orderId)))
          || (exists(/databases/$(database)/documents/orders/$(orderId))
            && orderReadable(resource.data));
      allow list: if orderReadable(resource.data);
      // Trusted HTTP checkout creates the order, items, payment and reservations atomically.
      allow create: if false;
      allow update: if lifecycleOrderUpdate(resource.data, request.resource.data)
          || bankConfirmationOrderUpdate(resource.data, request.resource.data);
      allow delete: if false;
      match /items/{itemId} {
        allow get, list: if orderReadable(
            get(/databases/$(database)/documents/orders/$(orderId)).data);
        allow create: if false;
        allow update, delete: if false;
      }
    }

    match /payments/{paymentId} {
      allow get: if orderReadable(
          get(/databases/$(database)/documents/orders/$(paymentId)).data);
      allow list: if false;
      allow create: if false;
      allow update: if request.resource.data.id == resource.data.id
          && request.resource.data.orderId == resource.data.orderId
          && request.resource.data.method == resource.data.method
          && request.resource.data.amount == resource.data.amount
          && (
            (resource.data.method == 'BANK_TRANSFER' && resource.data.status == 'PENDING'
              && request.resource.data.status == 'PAID'
              && request.resource.data.referenceCode is string
              && request.resource.data.referenceCode.size() >= 3
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'referenceCode', 'paidAt', 'updatedAt'
              ])
              && bankConfirmationOrderUpdate(
                get(/databases/$(database)/documents/orders/$(paymentId)).data,
                getAfter(/databases/$(database)/documents/orders/$(paymentId)).data))
            || (lifecycleActor(get(/databases/$(database)/documents/orders/$(paymentId)).data)
              && request.resource.data.status == getAfter(/databases/$(database)/documents/orders/$(paymentId)).data.paymentStatus
              && getAfter(/databases/$(database)/documents/orders/$(paymentId)).data.status in ['DELIVERED', 'CANCELLED']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'paidAt', 'updatedAt'
              ]))
          );
      allow delete: if false;
    }

    match /shipments/{shipmentId} {
      allow get: if orderReadable(
          get(/databases/$(database)/documents/orders/$(shipmentId)).data);
      allow list: if false;
      allow create: if false;
      allow update: if lifecycleActor(get(/databases/$(database)/documents/orders/$(shipmentId)).data)
          && request.resource.data.id == resource.data.id
          && request.resource.data.orderId == resource.data.orderId
          && (
            (isApprovedSeller(request.auth.uid)
              && get(/databases/$(database)/documents/orders/$(shipmentId)).data.sellerId == request.auth.uid
              && get(/databases/$(database)/documents/orders/$(shipmentId)).data.status in ['CONFIRMED', 'PREPARING', 'SHIPPING']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'carrierName', 'trackingCode', 'updatedAt'
              ])
              && request.resource.data.carrierName is string
              && request.resource.data.carrierName.size() > 0
              && request.resource.data.carrierName.size() <= 120
              && request.resource.data.trackingCode is string
              && request.resource.data.trackingCode.size() > 0
              && request.resource.data.trackingCode.size() <= 120
              && request.resource.data.updatedAt == request.time)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && ((getAfter(/databases/$(database)/documents/orders/$(shipmentId)).data.status == 'PREPARING'
                && request.resource.data.status == 'READY')
            || (getAfter(/databases/$(database)/documents/orders/$(shipmentId)).data.status == 'SHIPPING'
                && request.resource.data.status == 'SHIPPING')
            || (getAfter(/databases/$(database)/documents/orders/$(shipmentId)).data.status == 'DELIVERED'
                && request.resource.data.status == 'DELIVERED')
            || (getAfter(/databases/$(database)/documents/orders/$(shipmentId)).data.status == 'CANCELLED'
                && request.resource.data.status == 'CANCELLED')
            || (getAfter(/databases/$(database)/documents/orders/$(shipmentId)).data.status in ['PENDING', 'CONFIRMED']
                && request.resource.data.status == 'PENDING'))
          ));
      allow delete: if false;
    }

    match /campaigns/{campaignId} {
      allow get, list: if resource.data.status == 'ACTIVE'
          || (isSignedIn() && resource.data.sellerId == request.auth.uid)
          || isAdmin();
      allow create: if isApprovedSeller(request.auth.uid)
          && request.resource.data.id == campaignId
          && request.resource.data.sellerId == request.auth.uid
          && request.resource.data.status in ['DRAFT', 'PENDING_APPROVAL']
          && request.resource.data.reservedQuantity == 0
          && request.resource.data.rescuedQuantity == 0
          && request.resource.data.get('viewCount', 0) == 0
          && validCampaign(request.resource.data)
          && hasNoCredentialFields(request.resource.data);
      allow update: if (
            (isApprovedSeller(request.auth.uid)
              && resource.data.sellerId == request.auth.uid
              && resource.data.status in ['DRAFT', 'REJECTED']
              && request.resource.data.status in ['DRAFT', 'PENDING_APPROVAL']
              && request.resource.data.reservedQuantity == resource.data.reservedQuantity
              && request.resource.data.rescuedQuantity == resource.data.rescuedQuantity)
            || (isApprovedSeller(request.auth.uid)
              && resource.data.sellerId == request.auth.uid
              && resource.data.status == 'ACTIVE'
              && resource.data.rescueMode == 'MOBILE_POINT'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'currentLatitude', 'currentLongitude', 'locationUpdatedAt',
                'locationSharingEnabled', 'updatedAt'
              ])
              && (request.resource.data.locationSharingEnabled == false
                || request.resource.data.locationUpdatedAt == request.time))
            || (lifecycleCampaignMutation(resource.data, request.resource.data))
            || (isAdmin()
              && ((resource.data.status == 'PENDING_APPROVAL'
                    && request.resource.data.status in ['ACTIVE', 'REJECTED'])
                || (resource.data.status == 'ACTIVE'
                    && request.resource.data.status == 'STOPPED'))
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'moderatedBy', 'moderatedAt', 'moderationReason', 'updatedAt'
              ])
              && (!(request.resource.data.status in ['REJECTED', 'STOPPED'])
                || request.resource.data.moderationReason.size() >= 3)
              && hasAdminModerationFields(request.resource.data))
          )
          && request.resource.data.id == resource.data.id
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.get('viewCount', 0) == resource.data.get('viewCount', 0)
          && validCampaign(request.resource.data)
          && hasNoCredentialFields(request.resource.data);
      allow delete: if false;

      match /reactions/{reactionId} {
        allow get, list: if activeCampaign(campaignId) || isAdmin();
        allow create: if hasRole(request.auth.uid, 'CUSTOMER') && activeCampaign(campaignId)
            && reactionId == request.auth.uid
            && request.resource.data.keys().hasOnly(['id', 'userId', 'campaignId', 'type', 'createdAt'])
            && request.resource.data.id == request.auth.uid
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.campaignId == campaignId
            && request.resource.data.type in ['LIKE', 'SUPPORT', 'CARE']
            && request.resource.data.createdAt is timestamp;
        allow update: if hasRole(request.auth.uid, 'CUSTOMER') && isOwner(reactionId) && activeCampaign(campaignId)
            && request.resource.data.keys().hasOnly(['id', 'userId', 'campaignId', 'type', 'createdAt'])
            && request.resource.data.id == resource.data.id
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.campaignId == campaignId
            && request.resource.data.type in ['LIKE', 'SUPPORT', 'CARE']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type', 'createdAt']);
        allow delete: if hasRole(request.auth.uid, 'CUSTOMER') && isOwner(reactionId) && activeCampaign(campaignId);
      }

      match /comments/{commentId} {
        allow get, list: if activeCampaign(campaignId) || isAdmin();
        allow create: if hasRole(request.auth.uid, 'CUSTOMER') && activeCampaign(campaignId)
            && request.resource.data.id == commentId
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.status == 'ACTIVE'
            && validCampaignComment(request.resource.data, campaignId);
        allow update: if hasRole(request.auth.uid, 'CUSTOMER') && resource.data.userId == request.auth.uid
            && activeCampaign(campaignId)
            && resource.data.status in ['ACTIVE', 'EDITED']
            && request.resource.data.id == resource.data.id
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.campaignId == resource.data.campaignId
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'status', 'updatedAt'])
            && request.resource.data.status in ['EDITED', 'DELETED']
            && validCampaignComment(request.resource.data, campaignId)
          || (isAdmin()
            && request.resource.data.id == resource.data.id
            && request.resource.data.campaignId == resource.data.campaignId
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.status == 'HIDDEN'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'updatedAt', 'moderatedBy', 'moderatedAt', 'moderationReason'
            ])
            && hasAdminModerationFields(request.resource.data)
            && validCampaignComment(request.resource.data, campaignId));
        allow delete: if false;
      }
    }

    function validAdminBanner(data, bannerId) {
      return data.keys().hasOnly([
            'id', 'title', 'imageUrl', 'imagePublicId', 'campaignId', 'displayOrder',
            'startDate', 'endDate', 'active', 'createdAt', 'updatedAt',
            'moderatedBy', 'moderatedAt', 'moderationReason'
          ])
          && data.id == bannerId
          && data.title is string && data.title.size() >= 3 && data.title.size() <= 120
          && data.imageUrl is string && data.imageUrl.size() <= 2048
          && (data.imageUrl == '' || data.imageUrl.matches('https://res\\.cloudinary\\.com/.+'))
          && data.get('imagePublicId', '') is string && data.get('imagePublicId', '').size() <= 300
          && data.campaignId is string && data.campaignId.size() <= 128
          && (data.campaignId == ''
            || get(/databases/$(database)/documents/campaigns/$(data.campaignId)).data.status == 'ACTIVE')
          && data.displayOrder is int && data.displayOrder >= 0 && data.displayOrder <= 10000
          && data.startDate is timestamp && data.endDate is timestamp && data.startDate < data.endDate
          && data.active is bool
          && (!data.active || data.imageUrl.size() > 0)
          && data.get('createdAt', request.time) is timestamp
          && data.updatedAt == request.time;
    }

    match /banners/{bannerId} {
      allow get, list: if resource.data.active == true || isAdmin();
      allow create: if isAdmin()
          && validAdminBanner(request.resource.data, bannerId)
          && request.resource.data.createdAt == request.time
          && hasAdminModerationFields(request.resource.data);
      allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'imageUrl', 'imagePublicId', 'campaignId', 'displayOrder',
            'startDate', 'endDate', 'active', 'updatedAt', 'moderatedBy',
            'moderatedAt', 'moderationReason'
          ])
          && validAdminBanner(request.resource.data, bannerId)
          && (request.resource.data.active == true
            || request.resource.data.moderationReason.size() >= 3)
          && hasAdminModerationFields(request.resource.data);
      allow delete: if false;
    }

    match /posts/{postId} {
      allow get: if (isApprovedSeller(request.auth.uid)
              && !exists(/databases/$(database)/documents/posts/$(postId)))
          || resource.data.status == 'PUBLISHED'
          || (isSignedIn() && resource.data.sellerId == request.auth.uid)
          || isAdmin();
      allow list: if resource.data.status == 'PUBLISHED'
          || (isSignedIn() && resource.data.sellerId == request.auth.uid)
          || isAdmin();
      // New authored content lives on Campaign documents. This collection is
      // retained only for historical Post records and report resolution.
      allow create: if false;
      allow update: if (
            (isAdmin()
              && ((resource.data.status == 'PENDING_APPROVAL'
                    && request.resource.data.status in ['PUBLISHED', 'REJECTED'])
                || (resource.data.status == 'PUBLISHED'
                    && request.resource.data.status == 'HIDDEN')
                || (resource.data.status == 'HIDDEN'
                    && request.resource.data.status == 'PUBLISHED'))
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'moderatedBy', 'moderatedAt', 'moderationReason', 'updatedAt'
              ])
              && (!(request.resource.data.status in ['REJECTED', 'HIDDEN'])
                || request.resource.data.moderationReason.size() >= 3)
              && hasAdminModerationFields(request.resource.data))
          )
          && validPost(request.resource.data)
          && hasNoCredentialFields(request.resource.data);
      allow delete: if false;

      match /reactions/{reactionId} {
        allow get, list: if publishedPost(postId);
        allow create, update, delete: if false;
      }

      match /comments/{commentId} {
        allow get, list: if publishedPost(postId) || isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /favorites/{favoriteId} {
      // Transactional favorite toggles must be able to read the deterministic
      // document before its first creation, when resource.data is absent.
      allow get: if hasRole(request.auth.uid, 'CUSTOMER')
          && (favoriteId.matches('^' + request.auth.uid + '_.*$')
            || resource.data.customerId == request.auth.uid);
      allow list: if hasRole(request.auth.uid, 'CUSTOMER')
          && resource.data.customerId == request.auth.uid;
      allow create: if hasRole(request.auth.uid, 'CUSTOMER')
          && request.resource.data.keys().hasOnly(['id', 'customerId', 'productId', 'createdAt'])
          && request.resource.data.customerId == request.auth.uid
          && request.resource.data.productId is string
          && request.resource.data.productId.size() > 0
          && favoriteId == request.auth.uid + '_' + request.resource.data.productId
          && request.resource.data.id == favoriteId
          && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if hasRole(request.auth.uid, 'CUSTOMER')
          && resource.data.customerId == request.auth.uid;
    }

    match /reviews/{reviewId} {
      allow get: if (!exists(/databases/$(database)/documents/reviews/$(reviewId))
          && isSignedIn() && hasRole(request.auth.uid, 'CUSTOMER'))
        || (exists(/databases/$(database)/documents/reviews/$(reviewId))
          && (resource.data.status == 'PUBLISHED' || isOwner(resource.data.customerId) || isAdmin()));
      allow list: if resource.data.status == 'PUBLISHED'
          || (isSignedIn() && resource.data.customerId == request.auth.uid) || isAdmin();
      allow create: if hasRole(request.auth.uid, 'CUSTOMER')
          && reviewSummaryWritten(request.resource.data.productId, reviewId)
          && request.resource.data.keys().hasOnly([
            'id', 'customerId', 'productId', 'orderId', 'orderItemId', 'rating',
            'content', 'imageUrls', 'imagePublicIds', 'status', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.customerId == request.auth.uid
          && request.resource.data.id == reviewId
          && reviewId == request.auth.uid + '_' + request.resource.data.orderId + '_' + request.resource.data.orderItemId
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && request.resource.data.content is string && request.resource.data.content.size() <= 1000
          && request.resource.data.imageUrls is list && request.resource.data.imageUrls.size() <= 5
          && request.resource.data.get('imagePublicIds', []) is list && request.resource.data.get('imagePublicIds', []).size() <= 5
          && request.resource.data.status == 'PUBLISHED'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.ownerType == 'CUSTOMER'
          && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.ownerId == request.auth.uid
          && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status == 'DELIVERED'
          && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId)/items/$(request.resource.data.orderItemId))
          && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)/items/$(request.resource.data.orderItemId)).data.productId == request.resource.data.productId;
      allow update: if reviewSummaryWritten(resource.data.productId, reviewId) && ((hasRole(request.auth.uid, 'CUSTOMER')
          && request.resource.data.keys().hasOnly([
            'id', 'customerId', 'productId', 'orderId', 'orderItemId', 'rating',
            'content', 'imageUrls', 'imagePublicIds', 'status', 'createdAt', 'updatedAt',
            'moderatedBy', 'moderatedAt', 'moderationReason'
          ])
          && resource.data.customerId == request.auth.uid
          && request.resource.data.id == resource.data.id
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.productId == resource.data.productId
          && request.resource.data.orderId == resource.data.orderId
          && request.resource.data.orderItemId == resource.data.orderItemId
          && request.resource.data.createdAt == resource.data.createdAt
          && resource.data.status in ['PUBLISHED', 'DELETED']
          && request.resource.data.status in ['PUBLISHED', 'DELETED']
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && request.resource.data.content is string && request.resource.data.content.size() <= 1000
          && request.resource.data.imageUrls is list && request.resource.data.imageUrls.size() <= 5
          && request.resource.data.get('imagePublicIds', []) is list && request.resource.data.get('imagePublicIds', []).size() <= 5
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'rating', 'content', 'imageUrls', 'imagePublicIds', 'status', 'updatedAt'
          ])
          && request.resource.data.updatedAt == request.time)
        || (isAdmin()
          && request.resource.data.id == resource.data.id
          && request.resource.data.customerId == resource.data.customerId
          && ((resource.data.status == 'PENDING'
                && request.resource.data.status in ['PUBLISHED', 'REJECTED'])
            || (resource.data.status == 'PUBLISHED' && request.resource.data.status == 'HIDDEN')
            || (resource.data.status == 'HIDDEN' && request.resource.data.status == 'PUBLISHED'))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'moderatedBy', 'moderatedAt', 'moderationReason', 'updatedAt'
          ])
          && (!(request.resource.data.status in ['REJECTED', 'HIDDEN'])
            || request.resource.data.moderationReason.size() >= 3)
          && hasAdminModerationFields(request.resource.data)));
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow get, list: if (isActiveAccount() && resource.data.reporterId == request.auth.uid) || isAdmin();
      allow create: if isActiveAccount() && request.resource.data.id == reportId
          && request.resource.data.reporterId == request.auth.uid
          && request.resource.data.targetType in ['USER', 'PRODUCT', 'CAMPAIGN', 'POST', 'COMMENT', 'REVIEW']
          && request.resource.data.targetId is string && request.resource.data.targetId.size() > 0
          && request.resource.data.reason is string
          && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 120
          && request.resource.data.description is string && request.resource.data.description.size() <= 1000
          && request.resource.data.status == 'PENDING'
          && request.resource.data.resolvedBy == '' && request.resource.data.resolutionNote == ''
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.keys().hasOnly([
            'id', 'reporterId', 'targetType', 'targetId', 'reason', 'description',
            'status', 'resolvedBy', 'resolutionNote', 'createdAt', 'updatedAt'
          ]);
      allow update: if isAdmin()
          && request.resource.data.id == resource.data.id
          && request.resource.data.reporterId == resource.data.reporterId
          && request.resource.data.targetType == resource.data.targetType
          && request.resource.data.targetId == resource.data.targetId
          && request.resource.data.reason == resource.data.reason
          && request.resource.data.description == resource.data.description
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.resolvedBy == request.auth.uid
          && ((resource.data.status == 'PENDING' && request.resource.data.status in ['IN_REVIEW', 'RESOLVED', 'REJECTED'])
            || (resource.data.status == 'IN_REVIEW' && request.resource.data.status in ['RESOLVED', 'REJECTED']))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'resolvedBy', 'resolutionNote', 'updatedAt'
          ])
          && request.resource.data.resolutionNote is string
          && request.resource.data.resolutionNote.size() <= 1000
          && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    function orderNotificationAllowed(data, id) {
      let path = /databases/$(database)/documents/orders/$(data.referenceId);
      let order = getAfter(path).data;
      return data.type == 'ORDER' && data.userId == order.ownerId
          && data.get('orderStatus', order.status) == order.status
          && id == data.referenceId + '_' + order.status
          && (exists(path) ? get(path).data.status != order.status && lifecycleActor(order)
              : order.status == 'PENDING' && checkoutOwnerAllowed(order));
    }

    match /notifications/{notificationId} {
      allow get, list: if isAdmin() || (isActiveAccount() && resource.data.userId == request.auth.uid);
      allow create: if (isAdmin() || orderNotificationAllowed(request.resource.data, notificationId))
          && request.resource.data.id == notificationId
          && request.resource.data.keys().hasOnly([
            'id', 'userId', 'type', 'title', 'body', 'referenceId', 'orderStatus', 'isRead', 'createdAt'
          ])
          && request.resource.data.userId is string
          && request.resource.data.type in ['ORDER', 'CAMPAIGN', 'PROMOTION', 'MODERATION', 'SYSTEM']
          && request.resource.data.title is string && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.body is string && request.resource.data.body.size() <= 1000
          && request.resource.data.referenceId is string && request.resource.data.referenceId.size() <= 128
          && request.resource.data.get('orderStatus', '') in ['', 'PENDING', 'CONFIRMED', 'PREPARING',
            'READY_FOR_PICKUP', 'SHIPPING', 'DELIVERED', 'CANCELLED']
          && request.resource.data.isRead == false
          && request.resource.data.createdAt == request.time;
      allow update: if isActiveAccount() && resource.data.userId == request.auth.uid
          && resource.data.isRead == false && request.resource.data.isRead == true
          && request.resource.data.keys().hasOnly([
            'id', 'userId', 'type', 'title', 'body', 'referenceId', 'orderStatus', 'isRead', 'createdAt', 'readAt'
          ])
          && request.resource.data.readAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']);
      allow delete: if false;
    }

    match /adminAuditLogs/{auditId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
          && request.resource.data.keys().hasOnly([
            'adminId', 'resourceType', 'resourceId', 'fromState', 'toState', 'reason', 'createdAt', 'reportId'
          ])
          && request.resource.data.adminId == request.auth.uid
          && request.resource.data.resourceType in [
            'SELLER_APPLICATIONS', 'USERS', 'POSTS', 'PRODUCTS', 'CAMPAIGNS',
            'CATEGORIES', 'BANNERS', 'REVIEWS', 'REPORTS', 'ORDERS', 'PRODUCT_BATCHES', 'SHIPPING_SETTINGS'
          ]
          && request.resource.data.resourceId is string
          && request.resource.data.resourceId.size() > 0
          && request.resource.data.fromState is string
          && request.resource.data.toState is string
          && request.resource.data.reason is string
          && request.resource.data.reason.size() <= 500
          && request.resource.data.get('reportId', '') is string
          && request.resource.data.get('reportId', '').size() <= 128
          && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /adminBootstrapAudit/{auditId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
