{
  "projectId": "nhom7-rescuefarm",
  "databaseId": "(default)",
  "engine": "FIRESTORE_NATIVE",
  "schemaMode": "schemaless",
  "emptyCollectionPolicy": "Do not create placeholder documents. Collections materialize on first real write.",
  "enforcement": ["firestore.rules", "Android repository validation", "functions backend validation"],
  "collections": [
    {"path":"users/{userId}","purpose":"Tài khoản và vai trò","documentId":"Firebase Auth UID","references":[]},
    {"path":"users/{userId}/addresses/{addressId}","purpose":"Địa chỉ nhận hàng","documentId":"addressId","references":["users/{userId}"]},
    {"path":"users/{userId}/devices/{deviceId}","purpose":"Thiết bị và FCM token","documentId":"SHA-256 token","references":["users/{userId}"]},
    {"path":"sellerPublicProfiles/{sellerId}","purpose":"Cửa hàng công khai và GPS điểm gửi","documentId":"seller UID","references":["users/{sellerId}"]},
    {"path":"sellerPaymentProfiles/{sellerId}","purpose":"Ngân hàng và QR riêng của seller","documentId":"seller UID","references":["users/{sellerId}"]},
    {"path":"sellerApplications/{sellerId}","purpose":"Hồ sơ đăng ký người bán","documentId":"seller UID","references":["users/{sellerId}"]},
    {"path":"categories/{categoryId}","purpose":"Danh mục nông sản","documentId":"categoryId","references":[]},
    {"path":"products/{productId}","purpose":"Sản phẩm","documentId":"productId","references":["users/{sellerId}","categories/{categoryId}"]},
    {"path":"productBatches/{batchId}","purpose":"Lô hàng và tồn kho","documentId":"batchId","references":["products/{productId}","campaigns/{activeCampaignId}?optional"]},
    {"path":"promotions/{productId}","purpose":"Khuyến mãi và giá theo số lượng","documentId":"productId","references":["products/{productId}","users/{sellerId}"]},
    {"path":"customerCarts/{customerId}","purpose":"Giỏ hàng khách đăng nhập; items là mảng trong document","documentId":"customer UID","references":["users/{customerId}","products/{items.productId}","productBatches/{items.batchId}"]},
    {"path":"orders/{orderId}","purpose":"Đơn hàng customer và guest","documentId":"requestId UUID","references":["users/{sellerId}","users/{ownerId}?customer-only","campaigns/{campaignId}?optional","productBatches/{batchReservations.keys}"]},
    {"path":"orders/{orderId}/items/{itemId}","purpose":"Sản phẩm và giá chụp tại thời điểm mua","documentId":"batchId","references":["orders/{orderId}","products/{productId}","productBatches/{batchId}"]},
    {"path":"payments/{orderId}","purpose":"Thanh toán, QR và kết quả xác minh","documentId":"orderId","references":["orders/{orderId}"]},
    {"path":"shipments/{orderId}","purpose":"Vận chuyển cho đơn DELIVERY","documentId":"orderId","references":["orders/{orderId}"]},
    {"path":"campaigns/{campaignId}","purpose":"Chiến dịch và phân bổ sản lượng theo lô","documentId":"campaignId","references":["users/{sellerId}","productBatches/{batchTargets.keys}"]},
    {"path":"campaigns/{campaignId}/comments/{commentId}","purpose":"Bình luận chiến dịch","documentId":"commentId","references":["campaigns/{campaignId}","users/{userId}"]},
    {"path":"campaigns/{campaignId}/reactions/{userId}","purpose":"Tương tác chiến dịch","documentId":"user UID","references":["campaigns/{campaignId}","users/{userId}"]},
    {"path":"banners/{bannerId}","purpose":"Ảnh quảng bá trên Home","documentId":"bannerId","references":["campaigns/{campaignId}?optional"]},
    {"path":"favorites/{favoriteId}","purpose":"Sản phẩm yêu thích","documentId":"customerId_productId","references":["users/{customerId}","products/{productId}"]},
    {"path":"reviews/{reviewId}","purpose":"Đánh giá sau nhận hàng","documentId":"customerId_orderId_orderItemId","references":["users/{customerId}","products/{productId}","orders/{orderId}","orders/{orderId}/items/{orderItemId}"]},
    {"path":"reports/{reportId}","purpose":"Báo cáo vi phạm và xử lý của admin","documentId":"reportId","references":["users/{reporterId}","targetPath: polymorphic resource"]},
    {"path":"notifications/{notificationId}","purpose":"Hộp thư thông báo","documentId":"event-derived or order-derived ID","references":["users/{userId}","referenceId + resourceType/type"]},
    {"path":"adminAuditLogs/{auditId}","purpose":"Lịch sử quản trị; giữ được tham chiếu lịch sử tới tài nguyên đã xóa","documentId":"auditId","references":["users/{adminId}","historical resourceType + resourceId"]},
    {"path":"appConfig/{configId}","purpose":"Cấu hình nghiệp vụ; hiện dùng shipping","documentId":"shipping","references":[]},
    {"path":"checkoutReceipts/{orderId}","purpose":"Chống tạo trùng đơn và chứng thực guest","documentId":"orderId","serverOnly":true,"references":["orders/{orderId}"]},
    {"path":"guestOrderCodes/{orderCode}","purpose":"Tra cứu đơn guest bằng mã và phone hash","documentId":"RF-UUID","serverOnly":true,"references":["orders/{orderId}"]},
    {"path":"guestOrderGrants/{tokenHash}","purpose":"Quyền truy cập đơn guest có hạn dùng","documentId":"SHA-256 token","serverOnly":true,"references":["orders/{orderId}"]},
    {"path":"requestLimits/{limitId}","purpose":"Giới hạn tần suất API","documentId":"hash purpose/IP/subject/time bucket","serverOnly":true,"references":[]},
    {"path":"campaignViewReceipts/{receiptId}","purpose":"Chống cộng trùng lượt xem chiến dịch","documentId":"hash campaign/viewer/day","serverOnly":true,"references":["campaigns/{campaignId}"]},
    {"path":"notificationOutbox/{eventId}","purpose":"Sự kiện thông báo chờ worker xử lý","documentId":"eventId","references":["resourceType + resourceId"]},
    {"path":"notificationDeliveries/{deliveryId}","purpose":"Trạng thái phát thông báo theo người nhận","documentId":"hash eventId/userId","serverOnly":true,"references":["notificationOutbox/{eventId}","users/{userId}"]},
    {"path":"notificationWorkerState/{stateId}","purpose":"Cursor, backfill và health của worker","documentId":"stateId","serverOnly":true,"references":[]},
    {"path":"adminBootstrapAudit/{auditId}","purpose":"Dấu vết cấp tài khoản admin qua CLI","documentId":"audit UUID","serverOnly":true,"references":["users/{targetUid}"]},
    {"path":"systemMigrations/{migrationId}","purpose":"Đánh dấu migration đã chạy; cần giữ để tránh chạy lại","documentId":"migration version","serverOnly":true,"references":[]},
    {"path":"campaignAssetReferences/{assetHash}","purpose":"Bảo vệ tài sản Cloudinary được chiến dịch sử dụng","documentId":"SHA-256 publicId","serverOnly":true,"references":["Cloudinary publicId"]},
    {"path":"campaignMediaDrafts/{campaignId}","purpose":"Bản nháp upload ảnh chiến dịch","documentId":"campaignId","serverOnly":true,"references":["users/{ownerUid}","campaigns/{campaignId}?may-not-yet-exist"]},
    {"path":"campaignMediaUploads/{uploadId}","purpose":"Phiên upload, commit và dọn ảnh chiến dịch","documentId":"upload UUID","serverOnly":true,"references":["users/{ownerUid}","campaigns/{campaignId}?draft-supported"]},
    {"path":"bankTransferReferences/{transferContent}","purpose":"Ánh xạ mã SEVQR sang đơn","documentId":"SEVQR payment code","serverOnly":true,"references":["orders/{orderId}","users/{sellerId}"]},
    {"path":"sepayWebhookEvents/{eventHash}","purpose":"Xác minh, chống lặp webhook và lưu giao dịch cần đối soát","documentId":"hash sellerId/transactionId","serverOnly":true,"references":["users/{sellerId}","orders/{orderId}?applied-only"]},
    {"path":"sepayBankTransactions/{transactionHash}","purpose":"Chặn dùng lại cùng giao dịch ngân hàng để trả đơn khác","documentId":"hash bank/account/bank-reference","serverOnly":true,"references":["orders/{orderId}","users/{sellerId}"]}
  ]
}
